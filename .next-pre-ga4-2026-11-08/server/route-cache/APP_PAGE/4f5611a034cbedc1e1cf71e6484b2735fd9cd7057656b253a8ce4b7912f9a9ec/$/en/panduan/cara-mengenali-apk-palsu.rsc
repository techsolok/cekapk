12:["$","div",null,{"className":"space-y-8 py-8","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home (EN)\",\"item\":\"https://cekapk.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"How to Spot Fake APKs and Scam Apps on Android\",\"item\":\"https://cekapk.com/en/panduan/cara-mengenali-apk-palsu\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"I received a wedding-invitation APK from a number I know. Does that make it safe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The sender's number may itself have been hijacked - that is exactly how this pattern spreads, from one victim to all their contacts. Confirm by voice call - and still never install it.\"}},{\"@type\":\"Question\",\"name\":\"How can a fake app drain a bank account?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Usually by reading OTP codes via SMS or Accessibility permission, then signing into the victim's banking - or by showing a fake bank login to harvest the password. Banks never ask for an OTP code: anyone who asks is a scammer.\"}},{\"@type\":\"Question\",\"name\":\"Can fake apps get into Play Store?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Rarely, but it has happened, and Google removes them once detected. So keep checking developer, reviews, and permissions even on Play Store.\"}}]}"}}],"$undefined","$undefined",["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/60","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1","children":[["$","li","/en",{"className":"flex items-center gap-1","children":[false,["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"English Home"}]]}],["$","li","/en",{"className":"flex items-center gap-1","children":[["$","span",null,{"aria-hidden":true,"children":"/"}],["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"Guides"}]]}],["$","li","/en/panduan/cara-mengenali-apk-palsu",{"className":"flex items-center gap-1","children":[["$","span",null,{"aria-hidden":true,"children":"/"}],["$","span",null,{"aria-current":"page","className":"font-medium text-ink","children":"How to Spot Fake APKs and Scam Apps on Android"}]]}]]}]}],["$","header",null,{"children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink sm:text-3xl","children":"How to Spot Fake APKs and Scam Apps on Android"}],"$undefined"]}],["$","section",null,{"className":"space-y-3","children":[["$","p","Fake apps are built to resemble ",{"className":"leading-relaxed text-ink/85","children":"Fake apps are built to resemble the ones you trust - banking, e-wallets, WhatsApp, even wedding invitations - with one goal: to get you to install and open them. In Indonesia, this pattern steals OTP codes, takes over accounts, and drains bank balances."}],["$","p","This guide summarises the signs ",{"className":"leading-relaxed text-ink/85","children":"This guide summarises the signs to check in under a minute before installing anything, and the steps to take if you or your family already installed one."}]]}],["$","section",null,{"className":"space-y-3","children":[["$","p","Sign one: it arrives by chat, no",{"className":"leading-relaxed text-ink/85","children":"Sign one: it arrives by chat, not from an official store. Banks, e-wallets, couriers, and agencies never send apps over WhatsApp or SMS. Files calling themselves wedding invitations, traffic tickets, or parcel receipts - ending in .APK, delivered through chat - are a well-documented Indonesian scam pattern; genuine invitations arrive as links or PDFs. The family rule is absolute: no app is ever installed from a chat. Sign two: the name and developer are almost right, but not right. Fakes copy names with small changes - a swapped letter, an added Mod or Pro, a slightly different icon. Compare with the official listing: a banking app's developer is the bank itself, and genuine download counts run into the millions. The next giveaway is the promise: free Premium forever, instant followers, money for no work."}],"$L1c","$L1d"]}],"$L1e",false,"$undefined","$L1f"]}]
1c:["$","p","Sign three: it demands dangerous",{"className":"leading-relaxed text-ink/85","children":"Sign three: it demands dangerous permissions immediately. Fake apps typically ask straight away for Accessibility, SMS reading, display over other apps, or device administrator - dressed up as 'verification'. For an invitation viewer, such requests make no sense; Accessibility plus SMS access is precisely the combination banking scams use to read OTP codes and control your phone remotely. After installing, watch for a hot phone, draining battery, ads on the home screen outside any app, or a fake-looking bank login over other apps."}]
1d:["$","p","If you already installed one, ac",{"className":"leading-relaxed text-ink/85","children":"If you already installed one, act immediately: switch on airplane mode, do not open any banking or e-wallet app, and delete the suspicious app. From a safe device, contact your bank to block access, change key passwords - main email first - and switch on two-step verification. Run a Play Protect scan after removal. If you handed over an OTP code, report it to the bank and police with screenshots, and consider a factory reset after backing up. Speed in the first hour decides how much loss can be prevented."}]
1e:["$","section",null,{"className":"space-y-3","id":"frequently-asked-questions","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Frequently Asked Questions"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","I received a wedding-invitation APK from a number I know. Does that make it safe?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"I received a wedding-invitation APK from a number I know. Does that make it safe?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"No. The sender's number may itself have been hijacked - that is exactly how this pattern spreads, from one victim to all their contacts. Confirm by voice call - and still never install it."}]]}],["$","details","How can a fake app drain a bank account?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"How can a fake app drain a bank account?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Usually by reading OTP codes via SMS or Accessibility permission, then signing into the victim's banking - or by showing a fake bank login to harvest the password. Banks never ask for an OTP code: anyone who asks is a scammer."}]]}],["$","details","Can fake apps get into Play Store?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Can fake apps get into Play Store?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Rarely, but it has happened, and Google removes them once detected. So keep checking developer, reviews, and permissions even on Play Store."}]]}]]}]]}]
