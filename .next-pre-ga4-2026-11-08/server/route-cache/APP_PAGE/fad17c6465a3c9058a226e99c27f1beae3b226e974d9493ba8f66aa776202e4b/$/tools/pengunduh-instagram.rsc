15:["$","header",null,{"children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink sm:text-3xl","children":"Pengunduh Video Instagram"}],["$","p",null,{"className":"mt-2 max-w-2xl leading-relaxed text-ink/75","children":"Tempel tautan kiriman, Reel, atau video Instagram yang bersifat publik, lihat pratinjau resminya, lalu unduh file MP4 aslinya. Tool ini tidak pernah meminta login Instagram-mu - kalau sebuah konten tidak publik, kami akan mengatakannya terus terang."}]]}]
