,{"children":["$","$L5",null,{"href":"/dmca","children":"DMCA & Penghapusan Konten"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/kebijakan-iklan","children":"Kebijakan Iklan & Konten Bersponsor"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/disclaimer","children":"Disclaimer"}]}]]}]]}]]}],["$","p",null,{"className":"mx-auto max-w-5xl px-4 text-xs text-ink/50","children":["© ",2026," ","CekAPK",". ","CekAPK"," tidak berafiliasi dengan Google, TikTok, Mojang/Microsoft, atau developer aplikasi mana pun kecuali dinyatakan secara tertulis."]}]]}]
