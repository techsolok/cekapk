1e:["$","header",null,{"children":[["$","h1",null,{"className":"text-[26px] font-extrabold leading-tight text-ink","children":"Cara Mengenali APK Palsu dan Aplikasi Penipuan di Android"}],["$","p",null,{"className":"mt-2 text-sm text-ink/55","children":["Terakhir dicek: ","2026-10-18"," - Panduan Bahasa Indonesia"]}]]}]
1f:["$","p","Aplikasi palsu dibuat me",{"className":"leading-relaxed text-ink/85","children":"Aplikasi palsu dibuat menyerupai aplikasi yang kamu percaya - perbankan, dompet digital, WhatsApp, bahkan undangan pernikahan - dengan satu tujuan: membuatmu memasang dan membukanya. Di Indonesia, pola ini dipakai untuk mencuri kode OTP, mengambil alih akun, dan menguras rekening."}]
20:["$","p","Panduan ini merangkum ta",{"className":"leading-relaxed text-ink/85","children":"Panduan ini merangkum tanda-tanda yang bisa kamu periksa dalam waktu kurang dari satu menit sebelum memasang apa pun, dan langkah yang harus segera dilakukan bila kamu atau keluargamu terlanjur memasang aplikasi palsu."}]
21:["$","section","Tanda 1: Datang Lewat Chat, Bukan dari Toko Resmi",{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Tanda 1: Datang Lewat Chat, Bukan dari Toko Resmi"}],[["$","p","Bank, dompet digital, ek",{"className":"leading-relaxed text-ink/85","children":"Bank, dompet digital, ekspedisi, dan instansi tidak pernah mengirim aplikasi lewat WhatsApp atau SMS. Berkas bertajuk undangan nikah digital, surat tilang, resi paket, tagihan, atau kurir yang berakhiran APK dan dikirim lewat chat adalah pola penipuan yang sudah sangat dikenal di Indonesia. Undangan dan dokumen asli berbentuk tautan atau PDF dari kanal resmi, bukan berkas aplikasi yang harus dipasang."}],["$","p","Aturannya mutlak dan mud",{"className":"leading-relaxed text-ink/85","children":"Aturannya mutlak dan mudah diingat keluarga: tidak ada aplikasi yang boleh dipasang dari chat. Titik. Bila ada keraguan, buka aplikasi resmi yang sudah terpasang atau hubungi layanan pelanggan dari nomor di situs resmi instansi itu - bukan nomor di pesan yang mencurigakan."}]]]}]
22:["$","section","Tanda 2: Nama dan Developer Hampir Sama, Tetapi Tidak Sama",{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Tanda 2: Nama dan Developer Hampir Sama, Tetapi Tidak Sama"}],[["$","p","Di luar Play Store maupu",{"className":"leading-relaxed text-ink/85","children":"Di luar Play Store maupun sesekali di hasil pencarian, aplikasi palsu meniru nama dengan perubahan kecil: huruf ditukar, ditambah kata Mod, Pro, Emas, atau 2026, ikon yang sedikit berbeda, dan nama developer yang mirip perusahaan asli. Selalu bandingkan dengan halaman resmi: developer aplikasi perbankan adalah bank itu sendiri, WhatsApp diterbitkan WhatsApp LLC/Meta, dan jumlah unduhan aplikasi resmi berskala jutaan sampai miliaran."}],["$","p","Janji adalah tanda berik",{"className":"leading-relaxed text-ink/85","children":"Janji adalah tanda berikutnya: premium gratis selamanya, followers instan, melihat profil privat, penghasil uang tanpa kerja, sinyal judi pasti menang. Di dunia aplikasi, janji yang melanggar aturan platform hampir selalu dibayar dengan data atau uangmu."}]]]}]
23:["$","section","Tanda 3: Meminta Izin Berbahaya Sejak Awal",{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Tanda 3: Meminta Izin Berbahaya Sejak Awal"}],[["$","p","Aplikasi palsu biasanya ",{"className":"leading-relaxed text-ink/85","children":"Aplikasi palsu biasanya langsung meminta izin Aksesibilitas, izin membaca SMS, tampil di atas aplikasi lain, atau menjadi administrator perangkat - sering dibungkus alasan seperti verifikasi atau keamanan. Untuk aplikasi undangan atau penampil dokumen, permintaan seperti itu sama sekali tidak masuk akal. Izin aksesibilitas dan baca SMS adalah kombinasi yang dipakai penipuan perbankan untuk membaca kode OTP dan mengendalikan HP dari jauh."}],["$","p","Perilaku setelah terpasa",{"className":"leading-relaxed text-ink/85","children":"Perilaku setelah terpasang juga berbicara: HP panas dan baterai boros tanpa sebab, iklan muncul di layar utama di luar aplikasi, aplikasi perbankan menutup sendiri, atau muncul layar masuk bank yang tampilannya janggal di atas aplikasi lain. Semua ini alasan untuk berhenti memakai HP untuk transaksi sampai perangkat bersih."}]]]}]
24:["$","section","Bila Terlanjur Memasang: Langkah Darurat",{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Bila Terlanjur Memasang: Langkah Darurat"}],[["$","p","Segera aktifkan mode pes",{"className":"leading-relaxed text-ink/85","children":"Segera aktifkan mode pesawat untuk memutus koneksi, jangan membuka aplikasi perbankan atau dompet digital, lalu hapus aplikasi mencurigakan itu. Dari perangkat lain yang aman, hubungi bank dan dompet digitalmu untuk memblokir akses, ganti kata sandi penting (email utama dulu, karena email adalah kunci pemulihan semua akun), dan aktifkan verifikasi dua langkah di mana-mana."}],["$","p","Jalankan pemindaian Play",{"className":"leading-relaxed text-ink/85","children":"Jalankan pemindaian Play Protect setelah penghapusan. Bila gejala berlanjut atau kamu sempat memberikan kode OTP dan melihat transaksi asing, laporkan ke bank dan kepolisian dengan bukti tangkapan layar, dan pertimbangkan reset pabrik setelah mencadangkan foto serta data penting secara aman. Kecepatan bertindak dalam jam pertama sangat menentukan seberapa besar kerugian bisa dicegah."}]]]}]
25:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Pertanyaan Umum"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Saya menerima APK undangan nikah dari nomor yang saya kenal, apakah berarti aman?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Saya menerima APK undangan nikah dari nomor yang saya kenal, apakah berarti aman?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tidak. Nomor pengirim bisa saja sudah dibajak - justru begitu pola ini menyebar, dari satu korban ke kontak-kontaknya. Konfirmasi lewat panggilan suara ke orangnya langsung, dan tetap jangan memasang berkas aplikasi dari chat apa pun alasannya."}]]}],["$","details","Bagaimana aplikasi palsu bisa menguras rekening?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana aplikasi palsu bisa menguras rekening?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Biasanya dengan membaca kode OTP lewat izin SMS atau aksesibilitas, lalu masuk ke perbankan korban dari perangkat penyerang, atau menampilkan layar bank palsu untuk memancing kata sandi. Karena itu bank tidak pernah mengirim aplikasi lewat chat dan tidak pernah meminta kode OTP - siapa pun yang memintanya adalah penipu."}]]}],["$","details","Apakah aplikasi palsu bisa masuk Play Store?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah aplikasi palsu bisa masuk Play Store?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Jarang, tetapi pernah terjadi, dan Google menurunkannya setelah terdeteksi. Karena itu tetap periksa developer, ulasan terbaru, dan izin bahkan di Play Store, dan segera hapus serta laporkan aplikasi yang terbukti bermasalah. Risiko di luar Play Store berkali-kali lebih besar."}]]}],["$","details","Penjual menawarkan APK premium murah lewat media sosial, apakah itu palsu?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Penjual menawarkan APK premium murah lewat media sosial, apakah itu palsu?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Hampir selalu bermasalah: berkas mod bajakan, akun curian, atau penipuan pembayaran di muka. Selain melanggar ketentuan layanan, kamu tidak punya perlindungan apa pun saat akun atau berkasnya mati. Gunakan jalur resmi atau versi gratis resmi."}]]}],["$","details","Bagaimana mengajari keluarga agar tidak tertipu APK palsu?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana mengajari keluarga agar tidak tertipu APK palsu?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ajarkan dua aturan yang mudah diingat: tidak memasang aplikasi dari chat dalam keadaan apa pun, dan tidak pernah memberikan kode OTP kepada siapa pun. Sediakan dirimu sebagai tempat bertanya sebelum mereka memasang sesuatu yang baru - satu pertanyaan bisa mencegah kerugian besar."}]]}]]}]]}]
