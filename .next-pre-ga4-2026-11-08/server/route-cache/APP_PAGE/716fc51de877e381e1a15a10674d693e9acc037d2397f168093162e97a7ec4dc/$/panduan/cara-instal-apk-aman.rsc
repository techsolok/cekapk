21:["$","p","Hampir semua kasus HP An",{"className":"leading-relaxed text-ink/85","children":"Hampir semua kasus HP Android terkena malware di Indonesia bermula dari satu momen: memasang aplikasi dari tempat yang salah. Kabar baiknya, menghindarinya tidak butuh keahlian teknis - cukup kebiasaan yang benar setiap kali memasang aplikasi baru."}]
22:["$","p","Panduan ini merangkum ca",{"className":"leading-relaxed text-ink/85","children":"Panduan ini merangkum cara instal yang aman dari awal sampai akhir: sumber yang boleh dipercaya, hal yang diperiksa sebelum menekan Instal, pengaturan keamanan yang wajib aktif, dan aturan khusus bila suatu saat kamu benar-benar harus memasang berkas APK dari luar Play Store."}]
