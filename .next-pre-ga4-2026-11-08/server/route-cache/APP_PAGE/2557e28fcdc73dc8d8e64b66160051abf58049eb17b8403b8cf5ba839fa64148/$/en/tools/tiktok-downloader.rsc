14:["$","header",null,{"children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink sm:text-3xl","children":"TikTok Video Downloader"}],["$","p",null,{"className":"mt-2 max-w-2xl leading-relaxed text-ink/75","children":"Paste a link to a public TikTok video, preview the details, then download the file the source provides — no watermark when TikTok itself provides it for that video. Free, no install, no account, and no login."}]]}]
