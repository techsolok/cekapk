a:["$","footer",null,{"className":"border-t border-mist bg-mist/60 pb-24 sm:pb-8","children":[["$","div",null,{"className":"mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-bold text-ink","children":"CekAPK"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink/70","children":"Situs Bahasa Indonesia untuk menemukan aplikasi Android, memakai tool online gratis, dan mengecek apakah sebuah APK aman sebelum menginstal."}]]}],["$","nav",null,{"aria-label":"Jelajahi","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Jelajahi"}],["$","ul",null,{"className":"mt-2 space-y-2 text-sm text-ink/70","children":[["$","li",null,{"children":["$","$L5",null,{"href":"/tools","children":"Tools Online"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/aplikasi","children":"Katalog Aplikasi"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/kategori","children":"Kategori"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/keamanan","children":"Keamanan APK"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/panduan","children":"Panduan"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/perpustakaan","children":"Perpustakaan APK Legal"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/tentang","children":"Tentang Kami"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/kontak","children":"Kontak"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/metodologi-verifikasi","children":"Metodologi Verifikasi"}]}]]}]]}],["$","nav",null,{"aria-label":"Legal","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Legal"}],["$","ul",null,{"className":"mt-2 space-y-2 text-sm text-ink/70","children":[["$","li",null,{"children":["$","$L5",null,{"href":"/privasi","children":"Kebijakan Privasi"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/ketentuan","children":"Ketentuan Penggunaan"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/dmca","children":"DMCA & Penghapusan Konten"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/kebijakan-iklan","children":"Kebijakan Iklan & Konten Bersponsor"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/disclaimer","children":"Disclaimer"}]}]]}]]}]]}],["$","p",null,{"className":"mx-auto max-w-5xl px-4 text-xs text-ink/50","children":["© ",2026," ","CekAPK",". ","CekAPK"," tidak berafiliasi dengan Google, TikTok, Mojang/Microsoft, atau developer aplikasi mana pun kecuali dinyatakan secara tertulis."]}]]}]
