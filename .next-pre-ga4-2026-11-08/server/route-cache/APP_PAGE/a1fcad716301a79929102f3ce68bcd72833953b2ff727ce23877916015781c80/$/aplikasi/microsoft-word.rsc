2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Microsoft Word"," Aman?"]}],[["$","p","Unduh Microsoft Word han",{"className":"leading-relaxed text-ink/85","children":"Unduh Microsoft Word hanya dari Google Play Store dan pastikan developer-nya adalah Microsoft Corporation. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; jangan menerima berkas instalasi dari tautan email atau chat yang mengaku dari kantor, karena aplikasi kerja tiruan dibuat untuk mengintip dokumen dan kredensial akunmu."}],["$","p","Dokumen dan rapat sering",{"className":"leading-relaxed text-ink/85","children":"Dokumen dan rapat sering memuat data kerja atau keluarga. Periksa alamat email penerima sebelum berbagi, gunakan tautan yang kedaluwarsa, dan pisahkan akun pribadi dari akun kantor agar akses bisa dicabut saat perangkat atau pekerjaan berubah."}]]]}]
