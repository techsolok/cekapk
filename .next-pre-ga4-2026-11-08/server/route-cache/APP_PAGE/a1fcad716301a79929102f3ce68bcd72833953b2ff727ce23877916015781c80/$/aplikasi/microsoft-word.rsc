30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Microsoft Word"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Microsoft Word aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Microsoft Word aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah Microsoft Corporation. Keamanan akun kerja setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, aktifkan verifikasi dua langkah, dan periksa dengan teliti alamat email penerima sebelum membagikan dokumen."}]]}],["$","details","Apakah Microsoft Word gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Microsoft Word gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis (fitur premium memerlukan langganan Microsoft 365). Periksa rincian paket di Play Store dan di dalam aplikasi sebelum berlangganan, karena harga dan batas penyimpanan dapat berubah. Jangan membeli lisensi murah dari penjual pihak ketiga; lisensi tidak resmi bisa dicabut dan dokumenmu bisa terkunci."}]]}],["$","details","Bagaimana cara membagikan dokumen Word tanpa memberi akses ke semua file saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara membagikan dokumen Word tanpa memberi akses ke semua file saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Bagikan per dokumen, bukan per folder, dan pilih mode 'orang tertentu' dengan alamat email penerima. Beri izin edit hanya bila penerima memang harus mengubah isi; untuk kontrak dan dokumen final, kirim sebagai PDF atau izin lihat saja. Tinjau dan cabut tautan berbagi lama dari OneDrive secara berkala."}]]}],["$","details","Bagaimana cara memasang Microsoft Word yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Microsoft Word yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Microsoft Word langsung di Play Store, cocokkan nama developer Microsoft Corporation, lalu ketuk Instal. Setelah selesai, masuk dengan akun kerjamu, periksa sinkronisasi dan ruang penyimpanan, lalu atur izin kalender serta notifikasi rapat sebelum membuat dokumen pertama."}]]}],["$","details","Kenapa Microsoft Word tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Microsoft Word tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Fitur tertentu juga memerlukan akun kerja atau paket organisasi. Bila Play Store menyatakan perangkat tidak kompatibel, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],["$","details","Apakah saya perlu membuat akun untuk memakai Microsoft Word?",{"className":"group p-4","children":["$L32","$L33"]}]]}]]}]
