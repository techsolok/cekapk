27:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Microsoft Word untuk And",{"className":"leading-relaxed text-ink/85","children":"Microsoft Word untuk Android dari Microsoft Corporation memungkinkan pengguna membuat, membaca, dan mengedit dokumen .docx di HP: surat, CV, laporan, dan tugas. Dokumen yang sama bisa dibuka di komputer lewat OneDrive, sehingga pekerjaan berpindah perangkat tanpa mengirim file bolak-balik."}],["$","p","Pelajar dan pekerja Indo",{"className":"leading-relaxed text-ink/85","children":"Pelajar dan pekerja Indonesia memakainya untuk membuka lampiran tugas dan kontrak, menyunting cepat saat jauh dari laptop, dan membagikan dokumen ke guru, klien, atau rekan kerja. Memahami batas fitur gratis dan berbaginya mencegah kejutan saat dokumen penting harus selesai di perjalanan."}]],[["$","div","Cara Microsoft Word Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara Microsoft Word Dipakai Sehari-hari"}],[["$","p","Masuk dengan akun Micros",{"className":"leading-relaxed text-ink/85","children":"Masuk dengan akun Microsoft, buka dokumen dari perangkat atau OneDrive, lalu edit dengan mode tampilan yang sesuai layar. Saat membagikan, pilih antara mengirim salinan file atau tautan OneDrive dengan izin lihat atau edit, dan periksa siapa saja yang bisa membuka tautan itu sebelum mengirim."}],["$","p","Di aplikasi kerja sepert",{"className":"leading-relaxed text-ink/85","children":"Di aplikasi kerja seperti Microsoft Word, manfaatnya paling terasa setelah akun, sinkronisasi, dan berbagi diatur dengan benar. Mulailah dari satu dokumen atau rapat, periksa siapa yang bisa melihat dan mengedit, serta ruang penyimpanan yang tersedia, lalu aktifkan integrasi kalender dan template setelah alur dasarmu berjalan. Cara bertahap ini membuatmu tahu fitur mana yang benar-benar mempercepat pekerjaan, tanpa menyerahkan dokumen kepada orang yang salah."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan Microsoft Word",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan Microsoft Word"}],[["$","p","Berbagi dokumen lewat ta",{"className":"leading-relaxed text-ink/85","children":"Berbagi dokumen lewat tautan 'siapa pun bisa mengedit' berbahaya untuk dokumen sensitif seperti kontrak, data karyawan, dan nilai siswa. Pilih penerima spesifik bila isinya rahasia, dan berhati-hatilah membuka .docx dari email tak dikenal karena dokumen bisa memuat konten berbahaya yang diarahkan aplikasi lain."}],["$","p","Periksa daftar orang yan",{"className":"leading-relaxed text-ink/85","children":"Periksa daftar orang yang memiliki akses sebelum membagikan dokumen penting, matikan tautan berbagi yang sudah tidak dipakai, dan simpan dokumen kerja di akun yang benar (pribadi vs kantor/sekolah). Unduh hanya dari Play Store dengan developer Microsoft Corporation."}]]]}]]]}]
