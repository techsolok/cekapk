["$","p",null,{"className":"font-semibold text-ink","children":"Masking & Penyesuaian Selektif (Premium)"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Pilih subjek, langit, atau area kuas untuk diedit terpisah dari keseluruhan foto - fitur langganan yang paling terasa manfaatnya."}]]}],["$","li","Sinkronisasi Cloud Adobe (Langganan)",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Sinkronisasi Cloud Adobe (Langganan)"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Foto dan seluruh langkah editnya tersedia di HP, tablet, dan komputer yang masuk dengan akun Adobe yang sama."}]]}]]}]]}]
