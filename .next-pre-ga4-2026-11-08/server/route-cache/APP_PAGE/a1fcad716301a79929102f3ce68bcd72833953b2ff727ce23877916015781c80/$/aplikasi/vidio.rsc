2a:["$","section",null,{"id":"izin","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Izin Aplikasi & Artinya"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Izin adalah \"kunci\" yang kamu berikan ke aplikasi. Ini izin yang umumnya diminta ","Vidio"," dan arti sederhananya:"]}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":"Izin-izin ini wajar untuk layanan tontonan: koneksi untuk memutar video, penyimpanan untuk cache dan unduhan resmi, dan akun untuk riwayat serta langganan."}],["$","ul",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","li","Internet & Jaringan",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Internet & Jaringan"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Wajib untuk memutar video dan menyesuaikan kualitas dengan kecepatan koneksi. Pemutaran latar atau unduhan resmi memerlukan koneksi stabil."}]]}],["$","li","Penyimpanan",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Penyimpanan"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dipakai untuk cache dan fitur unduh resmi bila judul serta paketmu mengizinkan. Hapus unduhan lama agar penyimpanan tidak penuh."}]]}],["$","li","Notifikasi",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Notifikasi"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk episode baru, rekomendasi, dan pengingat tontonan. Batasi hanya pada serial atau kanal yang benar-benar kamu ikuti."}]]}],["$","li","Akun & Langganan",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Akun & Langganan"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk riwayat, daftar saya, dan akses paket berbayar. Jangan membagikan kata sandi; gunakan profil dan PIN bila tersedia untuk anak."}]]}]]}],["$","p",null,{"className":"text-sm text-ink/70","children":["Daftar izin persis dapat berbeda antar versi dan perangkat. Selalu periksa di halaman Play Store aplikasi dan di Pengaturan > Aplikasi > ","Vidio"," > Izin. Baca juga ",["$","$L5",null,{"className":"font-semibold text-linkblue","href":"/panduan/cara-cek-izin-aplikasi","children":"panduan cara cek izin aplikasi"}],"."]}]]}]
2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Vidio"," Aman?"]}],[["$","p","Unduh Vidio hanya dari G",{"className":"leading-relaxed text-ink/85","children":"Unduh Vidio hanya dari Google Play Store dan pastikan developer-nya adalah PT Vidio Dot Com. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; jangan memasang aplikasi \"nonton gratis premium\" dari chat dan situs pengumpul APK, karena aplikasi tiruan streaming adalah cara paling umum akun langganan dan data pembayaran dicuri."}],["$","p","Gunakan profil anak dan ",{"className":"leading-relaxed text-ink/85","children":"Gunakan profil anak dan batas usia bila layanan menyediakannya, terutama untuk katalog campuran. Langganan resmi juga melindungi riwayat dan pembayaranmu; akun bersama dari penjual murah sering dicabut dan dapat berasal dari pembayaran curian."}]]]}]
