2e:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Vidio diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
2f:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","Vidio"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Bstation (Bilibili)",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/bstation","className":"font-semibold text-linkblue","children":"Bstation (Bilibili)"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Pilihan legal utama untuk anime subtitle Indonesia dengan banyak konten gratis beriklan."}]]}],["$","li","Netflix",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/netflix","className":"font-semibold text-linkblue","children":"Netflix"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Layanan berlangganan global untuk film dan serial internasional, dengan katalog Indonesia yang berbeda dari Vidio."}]]}],["$","li","YouTube",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/youtube","className":"font-semibold text-linkblue","children":"YouTube"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk kanal resmi televisi, kreator, dan sebagian tayangan legal gratis yang diterbitkan pemiliknya."}]]}]]}]]}]
30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Vidio"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Vidio aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Vidio aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah PT Vidio Dot Com. Keamanan akun tontonan setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, jangan membagikan akun langganan kepada penjual murah, dan periksa perangkat yang masuk ke akunmu secara berkala."}]]}],["$","details","Apakah Vidio gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Vidio gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Sebagian konten gratis; paket berbayar diperlukan untuk banyak konten premium, serial eksklusif, dan pertandingan tertentu. Periksa rincian paket di Play Store dan di dalam aplikasi sebelum berlangganan, karena harga dan katalog dapat berubah. Jangan membeli akun langganan murah dari penjual pihak ketiga; akun bersama seperti itu sering dicabut dan bisa berasal dari pembayaran curian."}]]}],["$","details","Apakah Vidio bisa dipakai menonton olahraga secara legal?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Vidio bisa dipakai menonton olahraga secara legal?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Bisa, untuk kompetisi dan pertandingan yang hak siarnya sedang dipegang Vidio dan termasuk dalam paketmu. Hak siar selalu dibatasi waktu, wilayah, dan paket, jadi periksa halaman pertandingan di aplikasi sebelum membeli. Jangan mengandalkan tangkapan layar jadwal lama atau tautan dari situs lain; bila pertandingan tidak tercantum sebagai bagian dari paketmu, berarti aksesnya tidak termasuk atau haknya berada di layanan lain."}]]}],["$","details","Bagaimana cara memasang Vidio yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Vidio yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Vidio langsung di Play Store, cocokkan nama developer PT Vidio Dot Com, lalu ketuk Instal. Setelah selesai, buat profil, atur batas usia bila ada anak yang menonton, dan periksa kualitas video serta izin unduhan sebelum memutar episode pertama."}]]}],["$","details","Kenapa Vidio tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Vidio tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Katalog dan judul tertentu juga dibatasi lisensi per wilayah, jadi tontonan yang ada di satu negara belum tentu ada di negara lain. Bila Play Store menyatakan perangkat tidak kompatibel, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L32"]}]]}]
