en":"Akun menyimpan riwayat dan daftar agar serial panjang lebih mudah diikuti dari hari ke hari."}]]}],["$","li","Paket Premium Resmi",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Paket Premium Resmi"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Paket berbayar membuka konten premium dan olahraga tertentu sesuai rincian di aplikasi."}]]}]]}]]}]
