assName":"font-semibold text-ink","children":"Teks Animasi Fleksibel"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Animasikan teks per huruf, kata, atau baris dengan font yang bisa kamu tambahkan sendiri untuk lirik dan judul yang bergerak."}]]}],["$","li","Impor Preset & Ekspor MP4/GIF",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Impor Preset & Ekspor MP4/GIF"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Mulai dari preset proyek komunitas lalu ekspor hasil akhir sebagai video atau GIF dengan pilihan kualitas dan ukuran berkas."}]]}]]}]]}]
