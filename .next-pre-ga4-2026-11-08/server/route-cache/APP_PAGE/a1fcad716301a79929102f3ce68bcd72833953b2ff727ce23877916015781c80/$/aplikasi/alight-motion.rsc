2e:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Alight Motion diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
2f:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","Alight Motion"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","CapCut",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/capcut","className":"font-semibold text-linkblue","children":"CapCut"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Jauh lebih ringan dan otomatis untuk video vertikal sehari-hari, dengan animasi siap pakai tanpa mengatur keyframe manual."}]]}],["$","li","KineMaster",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/kinemaster","className":"font-semibold text-linkblue","children":"KineMaster"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Lebih cocok untuk menyusun video panjang dengan banyak klip dan narasi, meskipun animasinya tidak sedetail Alight Motion."}]]}],["$","li","PicsArt",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/picsart","className":"font-semibold text-linkblue","children":"PicsArt"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk edit foto, stiker, dan efek visual statis yang kemudian bisa dirangkai menjadi video sederhana."}]]}]]}]]}]
30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Alight Motion"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Alight Motion aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Alight Motion aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah SPLICE VIDEO EDITOR SRL. Keamanan akun editor setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, aktifkan verifikasi dua langkah bila tersedia, dan periksa lisensi aset sebelum memakai hasil edit untuk keperluan komersial."}]]}],["$","details","Apakah Alight Motion gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Alight Motion gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis dengan watermark (keanggotaan berbayar untuk fitur penuh & tanpa watermark). Periksa rincian di Play Store sebelum berlangganan, karena harga paket dan fitur yang terkunci dapat berubah. Jangan membeli editor \"tanpa watermark\" dari pihak ketiga; itu bukan cara resmi, berkasnya bajakan, dan akunmu bisa dibatasi."}]]}],["$","details","Kenapa Alight Motion terasa berat dan sering lag di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Alight Motion terasa berat dan sering lag di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Karena setiap lapisan efek dihitung ulang untuk setiap frame saat pratinjau dan ekspor - proyek dengan banyak lapisan blur, glow, dan keyframe memang pekerjaan berat bahkan untuk HP kelas menengah. Kurangi bebannya dengan menurunkan resolusi pratinjau, menonaktifkan sementara efek saat menyusun gerakan, memecah edit panjang menjadi beberapa proyek, dan menutup aplikasi lain sebelum ekspor. Bila proyek tetap tertutup sendiri, kemungkinan RAM perangkatmu memang tidak mencukupi untuk kompleksitas proyek itu, dan mengurangi jumlah lapisan adalah satu-satunya perbaikan nyata."}]]}],["$","details","Bagaimana cara memasang Alight Motion yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Alight Motion yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Alight Motion langsung di Play Store, cocokkan nama developer SPLICE VIDEO EDITOR SRL, lalu ketuk Instal. Setelah selesai, berikan akses file pada folder yang kamu pilih dan periksa pengaturan ekspor serta watermark sebelum mengedit proyek pertama."}]]}],["$","details","Kenapa Alight Motion tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Alight Motion tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Aplikasi editor juga membutuhkan ruang penyimpanan dan versi Android yang cukup baru untuk fitur tertentu. Bila Play Store menyatakan perangkat tidak kompatibel, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L33"]}]]}]
