26:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Canva adalah platform de",{"className":"leading-relaxed text-ink/85","children":"Canva adalah platform desain seret-dan-lepas (drag and drop) yang membuat orang tanpa latar desain bisa membuat poster, presentasi, undangan, logo sederhana, dan konten media sosial yang rapi dari template. Di Indonesia Canva dipakai guru, siswa, UMKM, admin komunitas, dan kantor kecil."}],["$","p","Halaman ini menjelaskan ",{"className":"leading-relaxed text-ink/85","children":"Halaman ini menjelaskan perbedaan Canva gratis dan Pro dengan jujur, fitur utamanya, izin aplikasi, dan catatan lisensi yang sering dilupakan pengguna gratis. Tombol hanya menuju Play Store; desainmu sendiri dikerjakan di aplikasi dan situs resmi Canva, bukan lewat jasa akun Pro abal-abal."}]],[["$","div","Gratis vs Pro vs Pendidikan",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Gratis vs Pro vs Pendidikan"}],[["$","p","Canva gratis sudah menca",{"className":"leading-relaxed text-ink/85","children":"Canva gratis sudah mencakup jutaan template, elemen dasar, dan penyimpanan cloud untuk proyek pribadi serta usaha kecil. Canva Pro menambah perpustakaan premium penuh, penghapus latar sekali klik, ubah ukuran ajaib ke banyak format, kit merek, dan ruang besar. Ada juga Canva untuk Pendidikan yang gratis bagi guru dan siswa yang terverifikasi sekolahnya - jalur resmi yang sering tidak diketahui."}],["$","p","Yang harus dihindari ada",{"className":"leading-relaxed text-ink/85","children":"Yang harus dihindari adalah jasa akun Pro murah dari penjual acak dan undangan tim asing yang beredar di media sosial. Akun seperti itu sering hasil penyalahgunaan, bisa dicabut sewaktu-waktu bersama desainmu di dalamnya, dan membagikan ruang tim dengan orang asing berarti desainmu bisa dilihat dan disalin."}]]]}],["$","div","Lisensi Elemen: Yang Sering Salah Kaprah",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Lisensi Elemen: Yang Sering Salah Kaprah"}],[["$","p","Tidak semua yang ada di ",{"className":"leading-relaxed text-ink/85","children":"Tidak semua yang ada di Canva bebas dipakai untuk apa pun. Elemen dan foto berlisensi punya ketentuan: umumnya aman untuk konten dan pemasaran, tetapi dilarang menjual elemen mentahnya sebagai stok, mencetak desain yang isinya hampir seluruhnya elemen berlisensi untuk dijual sebagai produk tersendiri, atau mendaftarkan desain berbasis template sebagai merek dagang tanpa perubahan berarti."}],["$","p","Untuk logo dan identitas",{"className":"leading-relaxed text-ink/85","children":"Untuk logo dan identitas usaha jangka panjang, gunakan elemen sederhana dan font yang aman, buat kombinasi yang benar-benar khas, dan simpan catatan desain finalmu. Bila ragu untuk pemakaian komersial besar, baca ringkasan lisensi resmi Canva atau konsultasi singkat akan jauh lebih murah daripada sengketa merek."}]]]}],["$","div","Canva di HP vs di Komputer",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Canva di HP vs di Komputer"}],[["$","p","Aplikasi HP cocok untuk ",{"className":"leading-relaxed text-ink/85","children":"Aplikasi HP cocok untuk konten cepat: poster pengumuman, story, dan suntingan ringan dari template. Pekerjaan presisi - presentasi panjang, dokumen banyak halaman, dan pengelolaan file besar - lebih nyaman di situs Canva lewat komputer. Keduanya tersinkron dari akun yang sama."}],"$L31"]]}]]]}]
