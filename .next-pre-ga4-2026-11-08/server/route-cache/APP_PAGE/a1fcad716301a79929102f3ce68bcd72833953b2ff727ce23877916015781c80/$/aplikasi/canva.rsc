2a:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Canva"," Aman?"]}],[["$","p","Canva resmi dari Play St",{"className":"leading-relaxed text-ink/85","children":"Canva resmi dari Play Store dan situs resminya aman. Risiko khas Canva bukan malware aplikasi, melainkan akun: jasa Pro murah, undangan tim dari orang asing, dan kata sandi yang dipakai ulang. Bila akunmu diambil alih, seluruh desain dan aset usahamu ikut hilang - gunakan kata sandi unik dan verifikasi email."}],["$","p","Dari sisi karya, hormati",{"className":"leading-relaxed text-ink/85","children":"Dari sisi karya, hormati lisensi elemen dan jangan mengunduh aset berbayar lewat situs pembocor template premium. Hasil desain yang akan dipakai komersial sebaiknya memakai elemen yang jelas statusnya dan kamu simpan bukti ekspor finalnya."}]]]}]
