26:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Zoom adalah aplikasi rap",{"className":"leading-relaxed text-ink/85","children":"Zoom adalah aplikasi rapat video dari Zoom (developer tercantum zoom.us di Play Store) yang dipakai untuk rapat kerja, kelas online, seminar, dan pertemuan keluarga. Kekuatan utamanya adalah tautan undangan yang mudah dibagikan dan kualitas panggilan yang relatif stabil di berbagai jaringan."}],["$","p","Di versi gratis, peserta",{"className":"leading-relaxed text-ink/85","children":"Di versi gratis, peserta bisa bergabung tanpa berlangganan, sedangkan batas durasi dan jumlah peserta terutama berlaku bagi penyelenggara rapat. Di Indonesia Zoom banyak dipakai sekolah, kampus, pelatihan, dan kantor yang pesertanya campuran perangkat dan kecepatan internet."}]],[["$","div","Cara Zoom Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara Zoom Dipakai Sehari-hari"}],[["$","p","Untuk bergabung, cukup k",{"className":"leading-relaxed text-ink/85","children":"Untuk bergabung, cukup ketuk tautan undangan dan masukkan nama tampilan yang pantas. Untuk menyelenggarakan, buat rapat dari kalender, atur kode sandi dan ruang tunggu, lalu bagikan tautan hanya ke peserta yang diundang. Periksa kamera dan mikrofon sebelum rapat dimulai, dan gunakan nama asli agar tuan rumah mudah mengenalimu."}],["$","p","Di aplikasi kerja sepert",{"className":"leading-relaxed text-ink/85","children":"Di aplikasi kerja seperti Zoom, manfaatnya paling terasa setelah akun, sinkronisasi, dan berbagi diatur dengan benar. Mulailah dari satu dokumen atau rapat, periksa siapa yang bisa melihat dan mengedit, serta ruang penyimpanan yang tersedia, lalu aktifkan integrasi kalender dan template setelah alur dasarmu berjalan. Cara bertahap ini membuatmu tahu fitur mana yang benar-benar mempercepat pekerjaan, tanpa menyerahkan dokumen kepada orang yang salah."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan Zoom",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan Zoom"}],[["$","p","Tautan rapat adalah kunc",{"className":"leading-relaxed text-ink/85","children":"Tautan rapat adalah kunci masuk. Tautan yang tersebar ke publik bisa dimasuki orang asing yang mengganggu rapat (sering disebut zoombombing). Jangan membagikan tautan dan kode sandi rapat tertutup di media sosial, dan jangan mengklik undangan Zoom dari email yang tidak kamu kenal."}],["$","p","Aktifkan ruang tunggu da",{"className":"leading-relaxed text-ink/85","children":"Aktifkan ruang tunggu dan kode sandi untuk rapat tertutup, kunci rapat setelah semua peserta masuk, dan nonaktifkan berbagi layar peserta bila tidak perlu. Unduh Zoom hanya dari Play Store dengan nama developer zoom.us, karena undangan palsu sering mengarahkan ke situs unduhan tiruan."}]]]}]]]}]
