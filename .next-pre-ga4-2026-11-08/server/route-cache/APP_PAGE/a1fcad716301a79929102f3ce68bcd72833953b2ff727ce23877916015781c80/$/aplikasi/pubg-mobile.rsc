24:["$","section",null,{"aria-label":"Skor keamanan","className":"rounded-2xl border border-mist p-4","children":[["$","h2",null,{"className":"font-bold text-ink","children":"Skor Keamanan"}],["$","div",null,{"className":"mt-2","children":["$","p",null,{"className":"text-sm text-ink/70","children":"Belum diverifikasi - kami tidak menyediakan file ini. Selalu unduh dari sumber resmi."}]}],["$","p",null,{"className":"mt-2 text-sm text-ink/60","children":["Skor angka hanya kami berikan untuk file yang kami host dan lolos pipeline verifikasi Fase 4. Untuk aplikasi ini, penilaian keamanannya kami jelaskan dengan kata-kata di bagian \"Apakah ","PUBG Mobile"," Aman?\" di bawah - tanpa angka karangan."]}]]}]
