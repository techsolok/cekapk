2e:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["PUBG Mobile diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
2f:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","PUBG Mobile"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Free Fire",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/free-fire","className":"font-semibold text-linkblue","children":"Free Fire"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Battle royale yang jauh lebih ringan dan cepat untuk HP kelas bawah, dengan gaya visual dan pertandingan yang lebih kasual."}]]}],["$","li","Mobile Legends",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/mobile-legends","className":"font-semibold text-linkblue","children":"Mobile Legends"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Alternatif kompetitif untuk mabar tanpa genre tembak-tembakan, dengan pertandingan yang jauh lebih singkat."}]]}],["$","li","Call of Duty: Mobile",{"className":"rounded-2xl border border-mist p-3","children":[["$","span",null,{"className":"font-semibold text-ink","children":"Call of Duty: Mobile"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Menawarkan battle royale sekaligus multiplayer klasik 5v5; belum ada di katalog kami, unduh resmi dari Play Store."}]]}]]}]]}]
30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","PUBG Mobile"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah PUBG Mobile aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah PUBG Mobile aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah Level Infinite. Keamanan akun game setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, aktifkan verifikasi dua langkah bila tersedia, dan jangan pernah membeli mata uang atau item game dari penjual di luar aplikasi resmi."}]]}],["$","details","Apakah PUBG Mobile gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah PUBG Mobile gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis (ada pembelian dalam aplikasi). Periksa rincian di Play Store sebelum membeli mata uang atau item dalam game, karena harga dan event dapat berubah. Jangan membeli diamond, Robux, atau skin murah dari penjual pihak ketiga; mata uang dari jalur tidak resmi bisa ditarik dan akunmu bisa dibatasi."}]]}],["$","details","Apakah memakai GFX tool atau config dari internet aman untuk PUBG Mobile?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah memakai GFX tool atau config dari internet aman untuk PUBG Mobile?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tidak aman dan tidak perlu. GFX tool dan config pihak ketiga mengubah berkas atau perilaku klien game di luar cara resmi, dan sistem keamanan PUBG Mobile dapat memperlakukannya sebagai modifikasi ilegal - sanksinya bisa berupa larangan bermain bertahun-tahun, bukan sekadar peringatan. Berkas config yang beredar juga sering dibundel aplikasi lain yang berbahaya. Semua kebutuhan yang dijanjikan tool itu - grafik lebih ringan, frame rate stabil - sudah tersedia lewat pengaturan grafis resmi di dalam game; gunakan itu dan sesuaikan dengan kemampuan HP-mu."}]]}],["$","details","Bagaimana cara memasang PUBG Mobile yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang PUBG Mobile yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari PUBG Mobile langsung di Play Store, cocokkan nama developer Level Infinite, lalu ketuk Instal. Setelah selesai, aktifkan persetujuan pembelian di Play Store dan atur izin mikrofon serta notifikasi sebelum bermain, terutama bila HP dipakai anak."}]]}],["$","details","Kenapa PUBG Mobile tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa PUBG Mobile tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Game berat juga menuntut RAM dan penyimpanan yang cukup, jadi perangkat lama mungkin dinyatakan tidak kompatibel. Bila Play Store menyatakan perangkat tidak didukung, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L33"]}]]}]
