2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Instagram"," Aman?"]}],[["$","p","Instagram resmi dari Pla",{"className":"leading-relaxed text-ink/85","children":"Instagram resmi dari Play Store diterbitkan oleh Meta dan aman dari sisi aplikasi. Bahaya di sekitar Instagram kebanyakan bukan aplikasinya, melainkan ekosistem palsu di sekitarnya: aplikasi penambah followers, penampil profil privat, dan pengunduh yang meminta login. Semua itu melanggar ketentuan, tidak bekerja seperti janji, dan sering berujung akun dicuri atau diblokir."}],["$","p","Dari sisi privasi, Insta",{"className":"leading-relaxed text-ink/85","children":"Dari sisi privasi, Instagram adalah layanan berbasis iklan: aktivitasmu dipakai untuk personalisasi iklan sesuai pengaturannya. Gunakan akun privat bila tidak berjualan, tinjau izin dan sesi login secara berkala, dan ingat bahwa mengunggah foto anak ke akun publik punya konsekuensi jangka panjang - pertimbangkan sebelum membagikan."}]]]}]
