1c:T43f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is CapCut really free?","acceptedAnswer":{"@type":"Answer","text":"Yes for its core toolkit, which is what most creators use daily. A Pro subscription adds premium effects, transitions, stock, and AI extras. The official price is the one shown in the Play Store — ignore any site promising Pro free forever."}},{"@type":"Question","name":"How do I remove the CapCut watermark?","acceptedAnswer":{"@type":"Answer","text":"For videos you edit yourself, export without a template and check the ending-watermark setting; the mark usually comes from a template's closing clip, which you can delete in the timeline. You do not need a modified app for this."}},{"@type":"Question","name":"Does CapCut work offline?","acceptedAnswer":{"@type":"Answer","text":"Basic editing of files already on your phone works offline. Downloading templates, music, and effects, and using cloud or AI features, needs an internet connection — grab the assets you need while on Wi-Fi if your data plan is tight."}}]}12:["$","div",null,{"className":"space-y-8 py-8","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home (EN)\",\"item\":\"https://cekapk.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"CapCut\",\"item\":\"https://cekapk.com/en/aplikasi/capcut\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/60","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1","children":[["$","li","/en",{"className":"flex items-center gap-1","children":[false,["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"English Home"}]]}],["$","li","/en",{"className":"