1c:T421,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Bstation legal?","acceptedAnswer":{"@type":"Answer","text":"Yes. Bstation is Bilibili's Southeast Asia service showing licensed content with official subtitles. That is its core difference from unofficial anime apps: the rights holders have granted permission, and the app is official on Play Store."}},{"@type":"Question","name":"Is Bstation free?","acceptedAnswer":{"@type":"Answer","text":"Most episodes can be watched free with advertising. Some of the newest episodes of popular titles open to Premium first, and there is an official paid Premium plan. Prices are always the ones shown inside the app."}},{"@type":"Question","name":"Why is my favourite title not on Bstation Indonesia?","acceptedAnswer":{"@type":"Answer","text":"Because streaming licences are split by country. A title may be licensed to a different service for Indonesia, or have no Indonesian licence holder yet. This is a limitation of every legal service, not a fault of the app."}}]}12:["$","div",null,{"className":"space-y-8 py-8","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home (EN)\",\"item\":\"https://cekapk.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Bstation (Bilibili)\",\"item\":\"https://cekapk.com/en/aplikasi/bstation\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/60","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1","children":[["$","li","/en",{"className":"flex items-center gap-1","children":[false,["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"English Home"}]]}],["$","li","/en",{"className":"flex items-