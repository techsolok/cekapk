23:["$","section",null,{"className":"space-y-3","children":[["$","p","Bstation is Bilibili's service n",{"className":"leading-relaxed text-ink/85","children":"Bstation is Bilibili's service name for Southeast Asia: a licensed anime streaming app - plus some Asian dramas and creator content - with Indonesian subtitles for many titles. For Indonesian anime viewers, Bstation is the main legal answer to pirated streaming apps and sites."}],["$","p","This page matters to our site: w",{"className":"leading-relaxed text-ink/85","children":"This page matters to our site: whenever someone searches for an unofficial anime app, this is the safe alternative we offer. We state the facts in full - free with ads, some episodes paid-Premium first - so you can decide with your eyes open."}]]}]
24:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["What ","Bstation (Bilibili)"," Does"]}],[["$","p","Bstation shows anime under licen",{"className":"leading-relaxed text-ink/85","children":"Bstation shows anime under licence from its rights holders. Most episodes can be watched free with ads; the newest episodes of popular titles sometimes open to Premium subscribers first and follow for free after a delay. That model is what keeps studios and creators paid, unlike pirated apps that show everything without permission. Catalogues differ by country because licences are regional - a title available elsewhere may not be in Indonesia, which is normal in legal streaming."}],["$","p","Unofficial anime apps such as Ku",{"className":"leading-relaxed text-ink/85","children":"Unofficial anime apps such as Kucing APK promise everything free with no ads. What they do not tell you: the sources are pirated, the app never passed Play Store review, its income comes from uncontrolled third-party ads, and your watch history sits on servers run by nobody identifiable. Bstation does carry ads, and some episodes sit behind Premium for a while - but your account is official, your history is stored safely, subtitles are professionally managed, and you infringe nobody's rights by watching. For casual viewers, the free tier is more than enough."}]]]}]
25:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Safety & Privacy"}],[["$","p","Bstation is an official Play Sto",{"className":"leading-relaxed text-ink/85","children":"Bstation is an official Play Store app from Bilibili and is safe to install. Because it is popular, lookalike files circulate on random sites promising an ad-free mod or free Premium - the same pattern as every other mod: unofficial, risky, and against the terms. Always install from Play Store."}],["$","p","For families: choose titles by a",{"className":"leading-relaxed text-ink/85","children":"For families: choose titles by age. Some anime is made for adult audiences, so use each title's rating and synopsis as your first guide before children watch on their own - the same responsibility as on any streaming service."}]]]}]
