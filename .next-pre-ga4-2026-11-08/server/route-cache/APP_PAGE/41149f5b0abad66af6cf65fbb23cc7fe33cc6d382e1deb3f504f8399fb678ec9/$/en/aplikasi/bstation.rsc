27:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Frequently Asked Questions"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Is Bstation legal?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Is Bstation legal?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Yes. Bstation is Bilibili's Southeast Asia service showing licensed content with official subtitles. That is its core difference from unofficial anime apps: the rights holders have granted permission, and the app is official on Play Store."}]]}],["$","details","Is Bstation free?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Is Bstation free?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Most episodes can be watched free with advertising. Some of the newest episodes of popular titles open to Premium first, and there is an official paid Premium plan. Prices are always the ones shown inside the app."}]]}],["$","details","Why is my favourite title not on Bstation Indonesia?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Why is my favourite title not on Bstation Indonesia?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Because streaming licences are split by country. A title may be licensed to a different service for Indonesia, or have no Indonesian licence holder yet. This is a limitation of every legal service, not a fault of the app."}]]}]]}]]}]
