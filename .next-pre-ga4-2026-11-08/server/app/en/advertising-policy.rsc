c:["$","$1","c",{"children":[["$","article",null,{"className":"prose-legal space-y-4 py-8","children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink","children":"Advertising & Sponsored Content Policy"}],["$","p",null,{"className":"text-sm text-ink/50","children":["Last updated: 8 November 2026 - Applies to ","CekAPK","."]}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["CekAPK"," does not currently run sponsored posts or display paid advertising. This policy describes how sponsored content and advertising would be handled if they are introduced in the future, so readers know the rules in advance."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Clear Identification"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Any sponsored article, paid placement, or advertisement will be clearly identified as sponsored or as an advertisement, in a way readers cannot miss. Sponsored content will never be presented as if it were an ordinary editorial article."}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Sponsored Content Is Not Editorial Opinion"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["Paid content does not automatically represent ","CekAPK","'s editorial opinion. A sponsored article reflects the advertiser's message, and will be labelled as such; our own guides, reviews, and security assessments are written independently and are not for sale."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Reviews and Security Ratings Cannot Be Bought"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Advertisers cannot purchase guaranteed positive reviews, favorable coverage, or security ratings. App descriptions are written from official sources, and security scores are calculated only from our verification pipeline. No payment changes a rating, a score, or whether an app is recommended."}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Affiliate Relationships"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["If affiliate relationships are introduced — links that earn ","CekAPK"," a commission when a reader buys something — they will be disclosed clearly on the page where the link appears and in this policy. We do not currently use affiliate links."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Sponsored Links"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Sponsored links will use appropriate link attributes, including rel=\"sponsored\" where applicable, so search engines and readers can distinguish paid links from editorial links."}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"What We Will Not Accept"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["CekAPK"," reserves the right to reject any promotion that is unsafe, misleading, illegal, or irrelevant to our readers — including pirated software, gambling, adult content, and products that contradict our safety mission. We may refuse a sponsorship for any reason, without explanation."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Editorial Independence and Reader Trust"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["Editorial independence and reader trust take priority over advertising revenue. If a sponsorship would require us to change an honest assessment, hide a risk, or mislead readers, we will not accept it. Questions about advertising or sponsorship can be sent to ","kontak@cekapk.com","."]}]]}],null,"$L10"]}]
