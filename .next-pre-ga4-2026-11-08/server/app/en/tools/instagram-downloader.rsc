15:["$","header",null,{"children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink sm:text-3xl","children":"Instagram Video Downloader"}],["$","p",null,{"className":"mt-2 max-w-2xl leading-relaxed text-ink/75","children":"Paste a link to a public Instagram post, Reel, or video, preview the official result, then download the original MP4 file. This tool never asks for your Instagram login — if content is not public, we will say so plainly."}]]}]
