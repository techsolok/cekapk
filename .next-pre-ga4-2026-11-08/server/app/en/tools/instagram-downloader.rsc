12:T8b7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does this tool ask for my Instagram login?","acceptedAnswer":{"@type":"Answer","text":"Never. This tool only processes public content with yt-dlp on the server. If a post is private or followers-only, the tool explains that and stops — we provide no way to enter Instagram credentials, and you should never give them to any website."}},{"@type":"Question","name":"Which formats are supported?","acceptedAnswer":{"@type":"Answer","text":"Public video posts, Reels, and IGTV with links in the form instagram.com/p/…, /reel/…, or /tv/…. Story links usually need a login, so they are not supported by our no-credentials design."}},{"@type":"Question","name":"Are the videos watermark-free?","acceptedAnswer":{"@type":"Answer","text":"Instagram does not burn a watermark into the original video the way the TikTok app does, so the file you receive is the original file the creator uploaded. We add no watermark of any kind."}},{"@type":"Question","name":"Why did my download fail even though the link is correct?","acceptedAnswer":{"@type":"Answer","text":"Instagram periodically limits access from server IP addresses. If you see a message that the source is unreachable, wait a few minutes and try again. We show that message as it is instead of hiding it."}},{"@type":"Question","name":"Is my link stored?","acceptedAnswer":{"@type":"Answer","text":"No. We only record anonymous metadata (event type and a hashed id) for statistics and abuse prevention. Download links are signed and expire in 10 minutes."}},{"@type":"Question","name":"May I download other people's videos?","acceptedAnswer":{"@type":"Answer","text":"Downloading for personal archiving is generally different from re-uploading. Re-uploading someone else's work without permission violates copyright and Instagram's terms. Use this tool for your own content or content whose permission is clear."}},{"@type":"Question","name":"Why is there a simple arithmetic challenge?","acceptedAnswer":{"@type":"Answer","text":"After several failed attempts in a row or too many requests, we show a light arithmetic challenge to hold off bots. A human passes it in seconds."}}]}e:["$","$1","c",{"children":[["$","div",null,{"className":"space-y-8 py-8","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"English Home\",\"item\":\"https://cekapk.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://cekapk.com/en/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Instagram Video Downloader\",\"item\":\"https://cekapk.com/en/tools/instagram-downloader\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/60","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1","children":[["$","li","/en",{"className":"flex items-center gap-1","children":[false,["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"English Home"}]]}],["$","li","/en/tools",{"className":"flex items-center gap-1","children":[["$","span",null,{"aria-hidden":true,"children":"/"}],["$","$L5",null,{"href":"/en/tools","className":"hover:text-primary-dark","children":"Tools"}]]}],["$","li","/en/tools/instagram-downloader",{"className":"flex items-center gap-1","children":["$L13","$L14"]}]]}]}],"$L15","$L16","$L17","$L18","$L19","$L1a"]}],null,"$L1b"]}]
