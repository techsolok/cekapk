17:["$","section",null,{"aria-label":"How to use","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"How to Use This Instagram Downloader"}],["$","ol",null,{"className":"list-decimal space-y-2 pl-5 leading-relaxed text-ink/80","children":[["$","li","Open the Instagram app and find the public video or Reel you want to save.",{"children":"Open the Instagram app and find the public video or Reel you want to save."}],["$","li","Tap the share icon (paper plane), then choose Copy Link.",{"children":"Tap the share icon (paper plane), then choose Copy Link."}],["$","li","Paste that link into the box on this page and press Get Video Info.",{"children":"Paste that link into the box on this page and press Get Video Info."}],["$","li","Check the preview and the owner's name to make sure it is the right video.",{"children":"Check the preview and the owner's name to make sure it is the right video."}],["$","li","Press Download Video. The original MP4 file from Instagram's server will stream through our server without being stored.",{"children":"Press Download Video. The original MP4 file from Instagram's server will stream through our server without being stored."}],["$","li","Use the file only as its rights allow: personal archiving and your own content are safe uses.",{"children":"Use the file only as its rights allow: personal archiving and your own content are safe uses."}]]}]]}]
18:["$","section",null,{"className":"space-y-3 leading-relaxed text-ink/80","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Why This Tool Is Built Differently"}],["$","p",null,{"children":"Many Instagram downloader sites show fake login forms or ask for your password. That is dangerous and never necessary for public content. This tool works like the Insta Grab project that shaped its design: extraction runs on the server with yt-dlp, with no visitor credentials at all. When Instagram limits access from the server, you get a message that explains it — not a deceptive ad or a fake download button."}],["$","p",null,{"children":"The video streams directly from Instagram's CDN through our server in the same request, signed with a token that expires in 10 minutes. We do not store video files, we do not store your full link, and we only record anonymous metadata to hold off abuse. The result is the original file exactly as the creator uploaded it."}],["$","p",null,{"children":"Remember that being able to download something is not permission to re-upload it. Creators' work is protected by copyright; keep it for personal archiving and ask permission before reusing anyone's work."}]]}]
