1c:T43b,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is there an official free Minecraft for Android?","acceptedAnswer":{"@type":"Answer","text":"There is no official free full version. The only official free option is Minecraft Trial, Mojang's limited demo on Play Store. Every site offering the full Minecraft APK for free is distributing piracy or a scam."}},{"@type":"Question","name":"How much does Minecraft cost on Android?","acceptedAnswer":{"@type":"Answer","text":"The official one-time price is shown on its Play Store page for Indonesia and can change during official promotions. Check the current figure through the official button on this page - we deliberately do not print a number that could go stale."}},{"@type":"Question","name":"If I buy it, can I install it on a new phone without paying again?","acceptedAnswer":{"@type":"Answer","text":"Yes. The purchase is tied to the Google account that bought it. Sign in with the same account on the new phone, open the Minecraft page on Play Store, and install it again free."}}]}12:["$","div",null,{"className":"space-y-8 py-8","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home (EN)\",\"item\":\"https://cekapk.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Minecraft\",\"item\":\"https://cekapk.com/en/aplikasi/minecraft\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/60","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1","children":[["$","li","/en",{"className":"flex items-center gap-1","children":[false,["$","$L5",null,{"href":"/en","className":"hover:text-primary-dark","children":"English Home"}]]}],["$","li","/en",{"classN