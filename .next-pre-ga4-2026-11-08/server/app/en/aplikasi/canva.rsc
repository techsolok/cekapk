26:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Frequently Asked Questions"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Can free Canva be used for selling?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Can free Canva be used for selling?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Generally yes, for marketing materials and business content, following the licence of the elements you used. Prohibited uses include reselling raw elements as stock and selling a printed product made almost entirely of licensed elements. Check Canva's licence summary before mass production."}]]}],["$","details","How can I get Canva Pro for free?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"How can I get Canva Pro for free?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Officially: Canva for Education for verified teachers and students, the non-profit programme, or an official trial when offered. Cheap Pro accounts from random sellers are easily revoked and endanger your designs. For most small businesses, free Canva already suffices."}]]}],["$","details","Can a Canva logo be registered as a trademark?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Can a Canva logo be registered as a trademark?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Be careful: a design heavily based on templates and stock elements is usually not distinctive enough, and Canva itself limits stock-element use in registered logos. Treat Canva as a starting point, or work with a designer."}]]}]]}]]}]
