27:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Frequently Asked Questions"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Is there an official TikTok Premium?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Is there an official TikTok Premium?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"No. TikTok is free with advertising and optional in-app purchases such as coins for live gifts. Any website offering a 'TikTok Premium' APK is distributing an unofficial, modified file that can harm your phone and get your account banned."}]]}],["$","details","Why does TikTok fill up my phone's storage?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Why does TikTok fill up my phone's storage?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Videos you watch are cached so replays and scrolling feel instant, and that cache grows over time, especially on 32 GB phones. Clear it from TikTok's in-app settings — not by installing a 'cleaner' version from a random site."}]]}],["$","details","Is TikTok safe for teenagers?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Is TikTok safe for teenagers?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"TikTok sets age limits and offers a restricted mode, screen-time reminders, and Family Pairing so parents can link accounts. Even so, the feed is a general-audience mix, so teenagers do best with supervision, a private account, and agreed time limits."}]]}]]}]]}]
