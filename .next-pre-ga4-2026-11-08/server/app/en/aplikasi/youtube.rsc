22:["$","section",null,{"className":"space-y-3","children":[["$","p","YouTube is the world's largest v",{"className":"leading-relaxed text-ink/85","children":"YouTube is the world's largest video platform, owned by Google, and in Indonesia it is the first stop for tutorials, news, music, religious talks, school lessons, and livestreams. Unlike pure short-video apps, its strength is depth: long-form video plus search means almost any practical question has a video answer."}],["$","p","This page summarizes the officia",{"className":"leading-relaxed text-ink/85","children":"This page summarizes the official app, gives an honest account of free versus Premium, and covers the risks of unofficial downloader and mod apps that surround it. The only button here leads to the Play Store — we do not provide modded YouTube APKs or downloaders that break the platform's terms."}]]}]
23:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["What ","YouTube"," Does"]}],[["$","p","YouTube now has three faces: tra",{"className":"leading-relaxed text-ink/85","children":"YouTube now has three faces: traditional long videos, Shorts — vertical clips competing with TikTok and Reels — and live streaming with audience chat and scheduled premieres. Watching is free with advertising. Subtitles and auto-captions cover many languages, and creators get the industry's most established monetization through the partner program for eligible channels."}],["$","p","YouTube Premium is the official ",{"className":"leading-relaxed text-ink/85","children":"YouTube Premium is the official paid tier: it removes ads, enables official downloads for offline viewing inside the app, background playback, and includes YouTube Music Premium, with family and student plans in many regions. Official downloads stay inside the app and respect creators' rules — the legal way to watch offline, and far safer than any third-party downloader."}]]]}]
24:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Safety & Privacy"}],[["$","p","The official YouTube app from Go",{"className":"leading-relaxed text-ink/85","children":"The official YouTube app from Google on the Play Store is the safe route. The hazard is its mod ecosystem: YouTube Vanced and similar mods were unofficial, their development has been discontinued, and successor files circulate through random sites where nobody can verify who changed them. Some mods even ask you to sign in to your Google account outside the official app — a direct risk to your entire Google identity."}],["$","p","On the content side, turn on res",{"className":"leading-relaxed text-ink/85","children":"On the content side, turn on restricted mode to reduce adult material, and for young children use YouTube Kids — a separate official app with filtered content — together with Google's Family Link for time limits. Manage watch history because recommendations learn from it, and never follow money or prize links in comments or descriptions; crypto and giveaway scams are common there."}]]]}]
25:["$","section",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","div",null,{"className":"rounded-2xl border border-mist p-4","children":[["$","h2",null,{"className":"font-bold text-ink","children":"Good for"}],["$","ul",null,{"className":"mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/80","children":[["$","li","Learning anything from deep tutorials",{"children":"Learning anything from deep tutorials"}],["$","li","Watching offline legally with official downloads",{"children":"Watching offline legally with official downloads"}],["$","li","Creators earning through the partner program",{"children":"Creators earning through the partner program"}]]}]]}],["$","div",null,{"className":"rounded-2xl border border-mist p-4","children":[["$","h2",null,{"className":"font-bold text-ink","children":"Watch out for"}],["$","ul",null,{"className":"mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/80","children":[["$","li","Discontinued mod apps like Vanced from random sites",{"children":"Discontinued mod apps like Vanced from random sites"}],["$","li","Heavy data use at high playback quality",{"children":"Heavy data use at high playback quality"}],["$","li","Scam prize links in comments and descriptions",{"children":"Scam prize links in comments and descriptions"}]]}]]}]]}]
26:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Frequently Asked Questions"}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","How can I download YouTube videos for offline viewing?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"How can I download YouTube videos for offline viewing?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Use the official Download button in the YouTube app on videos that allow it; the video stays inside the app for offline viewing. Third-party download sites and apps violate YouTube's terms and often carry malware — the exception is your own videos, via YouTube Studio."}]]}],["$","details","Is YouTube Vanced safe?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Is YouTube Vanced safe?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Vanced was an unofficial app and its development has been discontinued. Lookalike files now circulating cannot be verified, and some request Google sign-in outside official channels. We recommend the official app and its built-in download feature instead."}]]}],["$","details","Can I watch YouTube without ads for free, legally?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Can I watch YouTube without ads for free, legally?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"There is no official ad-free option besides Premium, apart from videos whose creators chose not to monetize. Ad blockers and mods violate the terms and some carry security risks. The honest choice is free with ads, or paying for Premium."}]]}]]}]]}]
