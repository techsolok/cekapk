8:["$","footer",null,{"className":"border-t border-mist bg-mist/60 pb-24 sm:pb-8","children":[["$","div",null,{"className":"mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-bold text-ink","children":"CekAPK"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink/70","children":"English edition of CekAPK: honest Android app guides on safety and official sources, a legal APK library, and free online tools."}]]}],["$","nav",null,{"aria-label":"Explore","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Explore"}],["$","ul",null,{"className":"mt-2 space-y-2 text-sm text-ink/70","children":[["$","li",null,{"children":["$","$L5",null,{"href":"/en","children":"English home"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/tools","children":"Tools"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/about","children":"About CekAPK"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/","children":"Indonesian edition (full catalog, guides & security)"}]}]]}]]}],["$","nav",null,{"aria-label":"Legal","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Legal"}],["$","ul",null,{"className":"mt-2 space-y-2 text-sm text-ink/70","children":[["$","li",null,{"children":["$","$L5",null,{"href":"/en/privacy-policy","children":"Privacy Policy"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/terms-of-use","children":"Terms of Use"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/dmca","children":"DMCA & Content Removal"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/advertising-policy","children":"Advertising & Sponsored Content"}]}],["$","li",null,{"children":["$","$L5",null,{"href":"/en/contact","children":"Contact"}]}]]}]]}]]}],["$","p",null,{"className":"mx-auto max-w-5xl px-4 text-xs text-ink/50","children":["© ",2026," ","CekAPK",". ","CekAPK"," is not affiliated with Google, TikTok,