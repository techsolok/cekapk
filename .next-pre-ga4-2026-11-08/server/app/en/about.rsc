b:["$","$1","c",{"children":[null,["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}]
c:["$","$1","c",{"children":[["$","article",null,{"className":"prose-legal space-y-4 py-8","children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink","children":"About CekAPK"}],["$","p",null,{"className":"text-sm text-ink/50","children":["Last updated: 7 November 2026 - Applies to ","CekAPK","."]}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["CekAPK"," was built for one simple problem: Indonesian users are often sent to APK sites that are heavy, full of fake download buttons, and risky. We built the alternative — light enough for entry-level phones, fully in Bahasa Indonesia, and honest about security."]}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Our editorial policy: descriptions are written originally from facts taken from official sources, verification dates are always shown, ratings are never invented, and pages that do not meet our quality standard are not published. Corrections can be submitted through the Contact page and will be recorded on the affected page."}],["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Why This Site Exists"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Finding an Android app should be simple: you want to know what an app does, whether it is safe, and where to download it officially. In practice, many APK sites make it harder — slow pages full of ads, misleading download buttons, descriptions copied word for word, and security claims with no evidence. The users hurt most are those with low-end phones and limited data, because every heavy page and every wrong download costs them both."}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["CekAPK"," is built on three promises you can check for yourself on every page: light, fully in Bahasa Indonesia, and honest about what we know and what we do not know. When information cannot be verified from an official source, we write it as unverified — we do not invent numbers or claims to make a page look convincing."]}],["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Our Editorial Policy"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Every app description on this site is written originally from facts taken from official sources, such as the Play Store page and the app publisher's website. We do not copy descriptions from other sites, and we do not invent version numbers, ratings, or release dates. Every app page shows the date it was last checked by an editor, and pages that have not been verified for a long time are marked so you know the information may have changed."}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Our quality standard also applies to what we do not publish. Pages that do not meet the standard — because the facts cannot be verified, the sources are unclear, or the app itself is problematic — are not published at all. We would rather have a smaller catalog you can trust than a large one full of doubtful pages."}],["$","h2",null,{"className":"text-xl font-bold text-ink","children":"How Verification Works"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"For apps whose files we provide in the library, verification follows a strict path: official sources first, the file's digital signature matched against a registered official fingerprint, the file scanned by several scanning engines, and its permissions explained in plain language — including warnings for dangerous permission combinations. A security score is only calculated when every step passes; a file that fails one step cannot be published. You can read the full methodology on the Security page (in Indonesian), and the real numbers on files published, held back, and reported on the Transparency page (in Indonesian)."}],"$L10","$L11","$L12","$L13","$L14","$L15"]}],null,"$L16"]}]
d:["$","$1","h",{"children":[null,[["$","$L17",null,{"children":"$L18"}],["$","meta",null,{"name":"next-size-adjust","content":""}]],["$","$L19",null,{"children":["$","div",null,{"hidden":true,"children":["$","$1a",null,{"fallback":null,"children":"$L1b"}]}]}]]}]
