c:["$","$1","c",{"children":[["$","article",null,{"className":"prose-legal space-y-4 py-8","children":[["$","h1",null,{"className":"text-2xl font-extrabold text-ink","children":"DMCA & Content Removal"}],["$","p",null,{"className":"text-sm text-ink/50","children":["Last updated: 8 November 2026 - Applies to ","CekAPK","."]}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["CekAPK"," respects copyright. Our policy is not to host copyrighted works without permission; our app pages are informational, and download buttons point to official sources or to files that have passed our verification pipeline."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Our Voluntary Reporting Process"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["This page describes ","CekAPK","'s voluntary reporting and review procedure for copyright complaints. It is not a representation that ","CekAPK"," has established every element of the formal US DMCA statutory process, and this page is not legal advice. If you need a formal statutory process, consult a legal adviser."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Who May Submit a Complaint"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"A copyright complaint may be submitted by the copyright owner, or by an agent authorized to act on the owner's behalf. If you are reporting on behalf of someone else, state your relationship to the owner and your authority to act for them."}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Information That Helps Us Review Your Report"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":["Send your report to ",["$","a",null,{"className":"font-semibold text-linkblue","href":"mailto:dmca@cekapk.com","children":"dmca@cekapk.com"}]," and include the following information so we can review it: (1) your identification and contact details, (2) identification of the copyrighted work claimed to have been infringed — enough detail for us to find it, (3) the exact URL on our site where the allegedly infringing material appears, and (4) a good-faith statement that you believe the use is not authorized by the copyright owner, its agent, or the law. This list is our practical guide for reviewing reports — not a complete checklist of statutory DMCA notice requirements. A report that does not include the exact URL or a clear identification of the work is hard for us to process."]}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"How We Review Reports"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"Our internal target is to review within 2 business days — this is our internal target, not a legal deadline. We check the reported URL, the identified work, and whether the material is hosted by us or only linked to an official source. When a report is valid, we aim to take appropriate action within that internal target; cases that require additional investigation may take longer. We will inform the reporter of the outcome; when a report is not valid, or when the material is only an informational page linking to an official source, we explain why. The number of copyright reports we receive is shown as an aggregate count on our Transparency page; no complainant personal information is published there."}],["$","h2",null,{"className":"text-lg font-bold text-ink","children":"Material Hosted or Linked by Third Parties"}],["$","p",null,{"className":"leading-relaxed text-ink/80","children":"When the material complained about sits on a third-party server, or when our page only links to it, action against that material may require the external host or the copyright owner. We can review our own pages and links — including removing a problematic link — but we cannot promise to remove material from third-party servers."}],"$L10","$L11","$L12","$L13"]}],null,"$L14"]}]
