11:["$","p",null,{"className":"leading-relaxed text-ink/80","children":["If your content was removed and you believe that was a mistake, or you are entitled to the material, send a response to ",["$","a",null,{"className":"font-semibold text-linkblue","href":"mailto:dmca@cekapk.com","children":"dmca@cekapk.com"}]," with: your identification and contact details, identification of the material and where it appeared on our site, and an explanation of why the removal was a mistake or why you are entitled to use the material. We review every response individually; there is no automatic restoration. The statutory 10–14-business-day procedure does not apply here — we review responses against the same 2-business-day internal target, and each decision is made case by case."]}]
12:["$","h2",null,{"className":"text-lg font-bold text-ink","children":"False or Careless Notices"}]
13:["$","p",null,{"className":"leading-relaxed text-ink/80","children":"A false or careless notice can harm others; please make sure your claim is correct before sending it. We do not accept notices that do not identify a specific work or a specific URL on our site."}]
