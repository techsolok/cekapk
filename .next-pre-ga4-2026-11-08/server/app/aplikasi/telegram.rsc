2a:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Telegram"," Aman?"]}],[["$","p","Telegram resmi aman seba",{"className":"leading-relaxed text-ink/85","children":"Telegram resmi aman sebagai aplikasi, tetapi reputasinya di Indonesia tercoreng oleh penyalahgunaan: penipuan berkedok admin channel, grup investasi bodong, channel film bajakan, dan judi. Ingat tiga hal: admin resmi tidak pernah meminta kode login lewat chat, tautan grup dari sumber tak jelas tidak wajib diikuti, dan konten bajakan/judi tetap ilegal walau mudah ditemukan."}],["$","p","Amankan akunmu dengan ve",{"className":"leading-relaxed text-ink/85","children":"Amankan akunmu dengan verifikasi dua langkah, kunci kode sandi aplikasi, dan pemeriksaan sesi aktif berkala. Untuk anak dan remaja, perhatikan bahwa pencarian publik Telegram bisa menemukan kanal dewasa dan ilegal - pendampingan dan edukasi tetap diperlukan, karena filter keluarga bawaan Telegram terbatas dibanding platform arus utama."}]]]}]
