26:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Telegram adalah aplikasi",{"className":"leading-relaxed text-ink/85","children":"Telegram adalah aplikasi pesan berbasis cloud yang dikenal karena grupnya yang sangat besar, channel siaran publik, bot, dan kemampuan mengirim file jauh lebih besar daripada aplikasi pesan biasa. Di Indonesia Telegram dipakai komunitas belajar, distribusi materi, komunitas hobi, sampai kanal pengumuman."}],["$","p","Halaman ini membahas fak",{"className":"leading-relaxed text-ink/85","children":"Halaman ini membahas fakta Telegram, perbedaan penting soal enkripsinya yang sering disalahpahami, izin, serta risikonya - termasuk channel ilegal yang harus kamu hindari. Tombol unduh hanya ke Play Store; kami tidak menyediakan file APK Telegram dari sumber lain."}]],[["$","div","Cloud Chat vs Secret Chat: Enkripsi yang Sering Salah Dipahami",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cloud Chat vs Secret Chat: Enkripsi yang Sering Salah Dipahami"}],[["$","p","Chat biasa di Telegram a",{"className":"leading-relaxed text-ink/85","children":"Chat biasa di Telegram adalah cloud chat: tersimpan terenkripsi di server Telegram sehingga bisa dibuka serentak di HP, tablet, dan komputer - nyaman, tetapi TIDAK terenkripsi end-to-end secara bawaan. Enkripsi end-to-end hanya ada di Secret Chat, yang harus kamu mulai manual per kontak, tidak masuk grup, dan tidak tersinkron antar perangkat."}],["$","p","Ini bukan berarti Telegr",{"className":"leading-relaxed text-ink/85","children":"Ini bukan berarti Telegram tidak aman untuk pemakaian umum, tetapi bila kebutuhanmu adalah percakapan yang wajib end-to-end secara bawaan di semua chat, WhatsApp dan Signal memang dirancang seperti itu. Pahami perbedaan ini sebelum memutuskan memakai Telegram untuk hal sensitif."}]]]}],["$","div","Channel, Grup Besar, dan Bot",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Channel, Grup Besar, dan Bot"}],[["$","p","Channel memungkinkan sat",{"className":"leading-relaxed text-ink/85","children":"Channel memungkinkan satu admin menyiarkan ke pelanggan tanpa batas, dan grup Telegram bisa menampung anggota dalam jumlah sangat besar dibanding aplikasi pesan lain. Bot adalah akun otomatis yang bisa menjalankan layanan - dari pengingat jadwal sampai kuis belajar - yang dibuat oleh komunitas maupun penyedia layanan."}],["$","p","Sisi gelapnya: kebebasan",{"className":"leading-relaxed text-ink/85","children":"Sisi gelapnya: kebebasan ini juga dipakai untuk channel film bajakan, grup judi, dan penyebaran konten ilegal, yang di Indonesia bisa berurusan dengan hukum bagi pengelola maupun penyebar. Gunakan Telegram untuk komunitas dan kanal yang legal, dan tinggalkan serta laporkan grup yang jelas melanggar hukum."}]]]}],["$","div","Kirim File Besar dan Pemakaian Lintas Perangkat",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Kirim File Besar dan Pemakaian Lintas Perangkat"}],[["$","p","Telegram mengizinkan pen",{"className":"leading-relaxed text-ink/85","children":"Telegram mengizinkan pengiriman file jauh lebih besar daripada aplikasi pesan umumnya, sehingga sering dipakai untuk berbagi dokumen dan video secara legal - misalnya materi kuliah dan berkas kerja. Karena berbasis cloud, file yang pernah kamu kirim atau terima tetap bisa diunduh ulang dari riwayat chat tanpa memenuhi HP."}],"$L32"]]}]]]}]
