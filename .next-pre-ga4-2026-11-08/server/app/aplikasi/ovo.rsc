28:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","OVO adalah dompet digita",{"className":"leading-relaxed text-ink/85","children":"OVO adalah dompet digital Indonesia yang digunakan untuk membayar QRIS, transfer, membeli pulsa dan paket data, membayar tagihan, serta transaksi di merchant dan layanan mitra. Karena OVO menyimpan saldo dan terhubung ke nomor HP, keamanan akun sangat bergantung pada kerahasiaan PIN, OTP, dan kendali atas nomor yang terdaftar. Aplikasi OVO yang sah hanya diambil dari Play Store dan dibuka dari ikon resmi; berkas OVO dari chat atau situs APK adalah jalur penipuan."}],["$","p","Pengguna memakai OVO unt",{"className":"leading-relaxed text-ink/85","children":"Pengguna memakai OVO untuk pembayaran cepat, promosi merchant tertentu, dan kebutuhan rutin yang tercatat dalam riwayat. Periksa status akun dan batas fitur sebelum mengandalkan OVO untuk nominal besar, karena layanan dompet digital dapat menerapkan verifikasi dan batas sesuai regulasi. Setelah mengganti HP atau nomor, selesaikan pemindahan akun hanya melalui proses resmi di aplikasi agar saldo dan riwayat tidak tertinggal di perangkat lama yang masih bisa diakses orang lain."}]],[["$","div","Cara OVO Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara OVO Dipakai Sehari-hari"}],[["$","p","Biasakan membuka OVO sec",{"className":"leading-relaxed text-ink/85","children":"Biasakan membuka OVO secara manual, bukan dari tautan pesan. Saat membayar, pindai QRIS dari dalam aplikasi, baca nama merchant, nominal, dan sumber dana sebelum memasukkan PIN. Saat transfer, ucapkan atau tulis ulang nomor tujuan dalam hati dan cocokkan nama penerima yang tampil. Bila aplikasi meminta kode OTP untuk tindakan sensitif, pastikan tindakan itu benar-benar kamu mulai sendiri di aplikasi resmi pada saat yang sama."}],["$","p","Di aplikasi keuangan sep",{"className":"leading-relaxed text-ink/85","children":"Di aplikasi keuangan seperti OVO, yang paling penting bukan banyaknya fitur, melainkan keamanan dan kejelasan biaya setiap transaksi. Mulailah dari fitur inti — cek saldo dan transfer kecil — periksa biaya layanan, batas transaksi, dan pengaturan keamanan akun, lalu aktifkan fitur lanjutan seperti tagihan otomatis setelah kamu paham risikonya. Cara bertahap ini membuatmu lebih mudah mengendalikan uang dan tidak mengaktifkan layanan yang biayanya tidak kamu sadari."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan OVO",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan OVO"}],[["$","p","Penipuan OVO sering data",{"className":"leading-relaxed text-ink/85","children":"Penipuan OVO sering datang sebagai pesan pemblokiran akun, hadiah saldo, pengembalian dana, atau customer service palsu yang meminta korban menginstal aplikasi tambahan dan membagikan layar. Jangan pernah memberikan OTP, PIN, password, atau kode verifikasi, termasuk kepada orang yang mengaku petugas. Jangan mengaktifkan aksesibilitas untuk aplikasi asing dan jangan mengikuti instruksi transfer demi membuka blokir. OVO resmi tidak menyelesaikan keamanan akun lewat APK yang dikirim melalui WhatsApp."}],["$","p","Jika menerima pesan bahw",{"className":"leading-relaxed text-ink/85","children":"Jika menerima pesan bahwa akun OVO akan diblokir, jangan klik tautan dan jangan panik. Tutup pesan itu, buka aplikasi OVO dari ikon resmi, periksa notifikasi dan riwayat secara langsung. Bila ada transaksi asing, segera gunakan fitur keamanan atau bantuan dari dalam aplikasi dan hubungi kanal resmi yang tercantum oleh OVO. Untuk pemulihan, kendalikan nomor HP dan email terdaftar; pihak ketiga yang menawarkan jasa pemulihan dengan meminta OTP harus ditolak."}]]]}]]]}]
29:["$","section",null,{"id":"fitur","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Fitur Utama ","OVO"]}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","li","Pembayaran QRIS dan Merchant",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Pembayaran QRIS dan Merchant"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Membayar di merchant yang menerima OVO atau QRIS dengan konfirmasi PIN di aplikasi resmi."}]]}],["$","li","Transfer Saldo dan Bank",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Transfer Saldo dan Bank"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Mengirim uang sesuai status akun, batas, dan biaya yang ditampilkan sebelum transaksi dikonfirmasi."}]]}],["$","li","Pulsa, Paket Data, dan Tagihan",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Pulsa, Paket Data, dan Tagihan"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Memenuhi kebutuhan rutin dari saldo OVO dengan riwayat yang tersimpan di akun."}]]}],["$","li","Riwayat Transaksi",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Riwayat Transaksi"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Membantu memeriksa pembayaran, transfer, promosi, dan aktivitas yang tidak kamu kenali."}]]}],["$","li","PIN dan Verifikasi Nomor",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"PIN dan Verifikasi Nomor"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Keamanan akun bertumpu pada nomor terdaftar, PIN rahasia, dan kode verifikasi yang tidak boleh dibagikan."}]]}],["$","li","Promo Merchant Bersyarat",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Promo Merchant Bersyarat"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Penawaran dan cashback mengikuti syarat merchant, periode, dan metode pembayaran di aplikasi."}]]}]]}]]}]
