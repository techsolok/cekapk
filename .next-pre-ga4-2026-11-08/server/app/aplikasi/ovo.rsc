2b:["$","section",null,{"id":"izin","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Izin Aplikasi & Artinya"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Izin adalah \"kunci\" yang kamu berikan ke aplikasi. Ini izin yang umumnya diminta ","OVO"," dan arti sederhananya:"]}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":"Izin-izin ini wajar untuk aplikasi keuangan: koneksi untuk transaksi, kamera untuk memindai kode dan verifikasi, dan notifikasi untuk mutasi serta peringatan keamanan."}],["$","ul",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","li","Internet & Keamanan Akun",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Internet & Keamanan Akun"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Wajib untuk transaksi dan verifikasi. Aktifkan PIN, biometrik, dan verifikasi dua langkah di dalam aplikasi; jangan pernah membagikan OTP."}]]}],["$","li","Kamera",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kamera"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk memindai QRIS, verifikasi identitas, atau mengambil dokumen yang diminta proses resmi. Lakukan hanya di dalam aplikasi resmi, bukan dari tautan chat."}]]}],["$","li","Kontak",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kontak"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dapat dipakai untuk memilih penerima transfer. Kamu bisa memasukkan nomor manual dan menolak akses kontak bila fitur tetap bekerja."}]]}],["$","li","Notifikasi",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Notifikasi"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Sangat penting untuk mutasi dan peringatan keamanan. Jangan matikan notifikasi transaksi; segera kunci akun bila ada transaksi yang tidak kamu kenali."}]]}],["$","li","Lokasi",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Lokasi"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Kadang dipakai untuk keamanan dan deteksi penipuan. Gunakan hanya saat aplikasi dipakai dan curigai aplikasi keuangan yang meminta aksesibilitas atau kontrol layar."}]]}]]}],["$","p",null,{"className":"text-sm text-ink/70","children":["Daftar izin persis dapat berbeda antar versi dan perangkat. Selalu periksa di halaman Play Store aplikasi dan di Pengaturan > Aplikasi > ","OVO"," > Izin. Baca juga ",["$","$L5",null,{"className":"font-semibold text-linkblue","href":"/panduan/cara-cek-izin-aplikasi","children":"panduan cara cek izin aplikasi"}],"."]}]]}]
2c:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","OVO"," Aman?"]}],[["$","p","Unduh OVO hanya dari Goo",{"className":"leading-relaxed text-ink/85","children":"Unduh OVO hanya dari Google Play Store dan pastikan developer-nya adalah PT Visionet Internasional. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; bank dan e-wallet tidak pernah membagikan APK lewat WhatsApp atau chat, dan aplikasi keuangan tiruan adalah cara paling umum saldo dan OTP dicuri."}],["$","p","Aplikasi keuangan hanya ",{"className":"leading-relaxed text-ink/85","children":"Aplikasi keuangan hanya boleh dipasang dari Play Store dan hanya boleh dibuka dari ikon resmi di HP-mu. Bank dan e-wallet tidak mengirim APK lewat WhatsApp, tidak meminta OTP, dan tidak menyuruh memasang aplikasi pendamping lewat chat. Bila ada yang melakukannya, anggap itu penipuan."}]]]}]
2d:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Cara Instal ","OVO"," dari Sumber Resmi"]}],["$","ol",null,{"className":"list-decimal space-y-2 pl-5 leading-relaxed text-ink/85","children":[["$","li",null,{"children":"Buka Google Play Store di HP kamu (atau klik tombol resmi di halaman ini)."}],["$","li",null,{"children":["Cari \"","OVO","\" dan pastikan nama developer-nya adalah ","PT Visionet Internasional","."]}],["$","li",null,{"children":"Ketuk Instal. Bila Play Store memperingatkan aplikasi tidak tersedia untuk perangkatmu, jangan mencari file APK dari situs acak - itu tanda perangkatmu tidak didukung."}],["$","li",null,{"children":["Setelah terinstal, buka Pengaturan > Aplikasi > ","OVO"," > Izin dan matikan izin yang tidak kamu butuhkan."]}]]}],["$","p",null,{"className":"text-sm text-ink/70","children":["Panduan lengkapnya: ",["$","$L5",null,{"className":"font-semibold text-linkblue","href":"/panduan/cara-instal-apk-aman","children":"cara instal aplikasi dengan aman"}],"."]}]]}]
