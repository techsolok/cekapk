2f:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["OVO diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
30:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","OVO"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","DANA",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/dana","className":"font-semibold text-linkblue","children":"DANA"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dompet digital Indonesia lain untuk QRIS, transfer, dan pembayaran tagihan dengan akun terpisah."}]]}],["$","li","GoPay",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/gopay","className":"font-semibold text-linkblue","children":"GoPay"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dompet digital ekosistem Gojek untuk pembayaran dan transfer, berguna bila kamu juga memakai layanan Gojek atau Tokopedia."}]]}],["$","li","LinkAja (di luar situs ini)",{"className":"rounded-2xl border border-mist p-3","children":[["$","span",null,{"className":"font-semibold text-ink","children":"LinkAja (di luar situs ini)"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Alternatif dompet digital Indonesia; pasang hanya dari Play Store dan verifikasi developer resminya."}]]}]]}]]}]
31:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","OVO"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah OVO aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah OVO aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah PT Visionet Internasional. Keamanan akun keuangan setelah pemasangan tetap tergantung padamu: gunakan PIN dan biometrik, aktifkan verifikasi dua langkah, dan jangan pernah membagikan OTP kepada siapa pun — termasuk yang mengaku dari bank atau layanan."}]]}],["$","details","Apakah OVO gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah OVO gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis untuk aplikasi; saldo, transfer, dan layanan tertentu mengikuti ketentuan biaya yang ditampilkan di aplikasi. Periksa rincian biaya layanan di dalam aplikasi sebelum bertransaksi, karena tarif dapat berubah dan ditampilkan di layar konfirmasi. Jangan membayar \"biaya aktivasi\" atau \"upgrade akun\" kepada siapa pun di luar aplikasi; layanan keuangan resmi tidak memungut biaya lewat chat."}]]}],["$","details","Bagaimana membedakan pesan resmi OVO dari phishing?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana membedakan pesan resmi OVO dari phishing?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Perlakukan semua pesan yang meminta OTP, PIN, kata sandi, pemasangan APK, atau berbagi layar sebagai phishing, apa pun nama pengirimnya. Pesan resmi tidak membuatmu harus menyerahkan kode rahasia. Bila isi pesan mengaku ada blokir, hadiah, atau transaksi bermasalah, jangan klik tautan; buka aplikasi OVO sendiri dari ikon resmi dan periksa notifikasi serta riwayat di sana. Bantuan hanya dipakai dari kanal resmi di aplikasi atau situs resmi yang kamu ketik sendiri."}]]}],["$","details","Bagaimana cara memasang OVO yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang OVO yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari OVO langsung di Play Store, cocokkan nama developer PT Visionet Internasional, lalu ketuk Instal. Setelah selesai, aktifkan PIN, biometrik, dan notifikasi transaksi di dalam aplikasi sebelum memasukkan saldo atau menghubungkan rekening."}]]}],["$","details","Kenapa OVO tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa OVO tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Layanan keuangan juga dapat menolak perangkat yang di-root atau sistemnya dimodifikasi, demi keamanan transaksi. Bila Play Store menyatakan perangkat tidak kompatibel, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L33"]}]]}]
