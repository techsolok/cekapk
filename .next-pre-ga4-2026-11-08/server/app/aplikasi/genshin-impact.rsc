2e:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Genshin Impact diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
2f:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","Genshin Impact"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Roblox",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/roblox","className":"font-semibold text-linkblue","children":"Roblox"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Jauh lebih ringan dan sosial untuk HP kelas bawah, tetapi isinya buatan komunitas dan bukan RPG cerita terstruktur seperti Genshin."}]]}],["$","li","Minecraft",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/minecraft","className":"font-semibold text-linkblue","children":"Minecraft"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Eksplorasi dan membangun dunia tanpa gacha sama sekali - sekali beli, cocok bila kamu lelah dengan sistem undian."}]]}],["$","li","Wuthering Waves",{"className":"rounded-2xl border border-mist p-3","children":[["$","span",null,{"className":"font-semibold text-ink","children":"Wuthering Waves"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"RPG dunia terbuka sejenis dengan pertarungan lebih cepat; belum ada di katalog kami, unduh resmi dari Play Store."}]]}]]}]]}]
30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Genshin Impact"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Genshin Impact aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Genshin Impact aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah COGNOSPHERE PTE. LTD.. Keamanan akun game setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, aktifkan verifikasi dua langkah bila tersedia, dan jangan pernah membeli mata uang atau item game dari penjual di luar aplikasi resmi."}]]}],["$","details","Apakah Genshin Impact gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Genshin Impact gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis (ada pembelian dalam aplikasi / sistem gacha). Periksa rincian di Play Store sebelum membeli mata uang atau item dalam game, karena harga dan event dapat berubah. Jangan membeli diamond, Robux, atau skin murah dari penjual pihak ketiga; mata uang dari jalur tidak resmi bisa ditarik dan akunmu bisa dibatasi."}]]}],["$","details","Apakah Genshin Impact harus membayar supaya bisa tamat?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Genshin Impact harus membayar supaya bisa tamat?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tidak. Semua wilayah, cerita utama, dan akhir konten yang tersedia bisa diselesaikan dengan karakter yang diberikan gratis dan didapat dari Wish memakai Primogem hasil bermain, selama tim dibangun dengan benar. Gacha menjual karakter dan senjata tertentu lebih cepat, bukan kunci untuk menamatkan game. Bahayanya justru psikologis: banner berganti setiap beberapa minggu dan rasa takut ketinggalan mendorong undian impulsif. Tentukan batas Primogem dan uang sebelum banner dimulai, dan berhenti saat batas tercapai apa pun hasilnya."}]]}],["$","details","Bagaimana cara memasang Genshin Impact yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Genshin Impact yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Genshin Impact langsung di Play Store, cocokkan nama developer COGNOSPHERE PTE. LTD., lalu ketuk Instal. Setelah selesai, aktifkan persetujuan pembelian di Play Store dan atur izin mikrofon serta notifikasi sebelum bermain, terutama bila HP dipakai anak."}]]}],["$","details","Kenapa Genshin Impact tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Genshin Impact tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Game berat juga menuntut RAM dan penyimpanan yang cukup, jadi perangkat lama mungkin dinyatakan tidak kompatibel. Bila Play Store menyatakan perangkat tidak didukung, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L33"]}]]}]
