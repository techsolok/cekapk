27:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Genshin Impact adalah RP",{"className":"leading-relaxed text-ink/85","children":"Genshin Impact adalah RPG aksi dunia terbuka dari HoYoverse (COGNOSPHERE) yang berlatar dunia fantasi Teyvat: kamu menjelajahi berbagai wilayah bangsa dengan pemandangan dan musik sekelas game konsol, menyelesaikan cerita utama yang terus berlanjut, dan bertarung memakai tim berisi empat karakter dengan tujuh elemen yang bisa bereaksi satu sama lain. Karakter dan senjata baru didapatkan terutama lewat sistem undian bernama Wish yang memakai mata uang Primogem. Seluruh cerita dan wilayahnya bisa diselesaikan tanpa membayar - yang dijual gacha adalah kecepatan dan karakter tertentu, bukan kemenangan."}],["$","p","Pemain memakai Genshin I",{"className":"leading-relaxed text-ink/85","children":"Pemain memakai Genshin Impact sebagai game cerita jangka panjang: menjelajahi wilayah baru setiap pembaruan besar, mengerjakan misi cerita dan misi dunia, membangun karakter lewat artefak dan material, serta menyelesaikan tantangan domain dan Spiral Abyss. Mode co-op memungkinkan sampai empat pemain menjelajah dan bertarung bersama di dunia salah satu pemain. Karena progres tersimpan di akun dan bisa dilanjutkan lintas perangkat (HP, PC, konsol) dengan akun yang sama, banyak pemain menjadikannya game utama yang dimainkan bertahun-tahun."}]],[["$","div","Cara Genshin Impact Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara Genshin Impact Dipakai Sehari-hari"}],[["$","p","Alur bermainnya berputar",{"className":"leading-relaxed text-ink/85","children":"Alur bermainnya berputar pada eksplorasi dan persiapan tim: buka peta dan titik teleport, kerjakan quest, kumpulkan material dari musuh dan alam, lalu naikkan level karakter, senjata, dan artefak. Energi harian bernama Resin membatasi hadiah dari domain dan bos, sehingga progres memang dirancang bertahap setiap hari. Primogem yang dikumpulkan dari bermain bisa disimpan untuk Wish pada banner karakter yang diinginkan, dan sistem jaminan (pity) memastikan karakter bintang lima dalam jumlah undian maksimum tertentu - memahami sistem ini penting sebelum memutuskan mengeluarkan uang."}],["$","p","Di game seperti Genshin ",{"className":"leading-relaxed text-ink/85","children":"Di game seperti Genshin Impact, yang paling terasa bedanya adalah perangkat dan koneksi: frame rate, ping, dan suhu HP menentukan nyaman tidaknya satu pertandingan. Mulailah dari mode santai dan pengaturan grafis menengah, periksa pembelian dalam aplikasi serta izin mikrofon sebelum bermain regu, lalu naikkan pengaturan dan aktifkan fitur lanjutan bila perangkatmu sanggup. Cara bertahap ini membuatmu tahu mana yang benar-benar menambah seru permainan, tanpa mengeluarkan uang atau data untuk fitur yang tidak kamu pakai."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan Genshin Impact",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan Genshin Impact"}],[["$","p","Risiko utama Genshin Imp",{"className":"leading-relaxed text-ink/85","children":"Risiko utama Genshin Impact adalah pengeluaran gacha yang tidak terasa. Karena undian dilakukan sedikit demi sedikit dengan mata uang bertingkat (uang sungguhan menjadi Genesis Crystal, lalu Primogem, lalu item Wish), pemain mudah kehilangan jejak total belanja saat mengejar satu karakter. Tetapkan batas tegas sebelum banner incaranmu datang, jangan pernah memakai uang kebutuhan, dan untuk anak, matikan pembayaran tersimpan - akun anak tidak boleh bisa menarik Wish berbayar sendiri. Membeli akun jadi juga berbahaya: melanggar ketentuan, rawan ditarik kembali penjual, dan akun curian sering berakhir diblokir."}],"$L32"]]}]]]}]
28:["$","section",null,{"id":"fitur","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Fitur Utama ","Genshin Impact"]}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","li","Dunia Terbuka Teyvat yang Terus Meluas",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Dunia Terbuka Teyvat yang Terus Meluas"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Wilayah-wilayah bangsa dengan budaya, musik, dan lanskap berbeda yang bisa dijelajahi bebas, ditambah berkala lewat pembaruan resmi."}]]}],["$","li","Sistem Elemen & Reaksi",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Sistem Elemen & Reaksi"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Tujuh elemen - api, air, es, petir, angin, tanah, dan tumbuhan - yang bereaksi satu sama lain dan menjadi inti strategi tim."}]]}],["$","li","Tim Empat Karakter Bergantian Cepat",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Tim Empat Karakter Bergantian Cepat"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Susun tim dari karakter yang kamu miliki dan berganti di tengah pertarungan untuk memicu reaksi elemen dan kombo kemampuan."}]]}],["$","li","Cerita Utama & Misi Karakter Bersuara Penuh",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Cerita Utama & Misi Karakter Bersuara Penuh"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Alur cerita panjang dengan pengisi suara dalam beberapa bahasa, ditambah misi pendamping untuk mengenal tiap karakter."}]]}],["$","li","Co-op sampai Empat Pemain",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Co-op sampai Empat Pemain"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Kunjungi dunia teman untuk bertarung melawan bos dan menyelesaikan domain bersama, dengan progres utama tetap di akun masing-masing."}]]}],["$","li","Wish dengan Sistem Jaminan (Pity)",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Wish dengan Sistem Jaminan (Pity)"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Undian karakter dan senjata dengan jaminan bintang lima dalam batas undian tertentu - pahami peluang dan batasnya sebelum memakai Primogem."}]]}]]}]]}]
