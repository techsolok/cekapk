2a:["$","section",null,{"id":"izin","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Izin Aplikasi & Artinya"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Izin adalah \"kunci\" yang kamu berikan ke aplikasi. Ini izin yang umumnya diminta ","Genshin Impact"," dan arti sederhananya:"]}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":"Izin-izin ini wajar untuk game daring: koneksi untuk bermain bersama, penyimpanan untuk aset dan tangkapan layar, dan mikrofon hanya bila kamu memakai obrolan suara."}],["$","ul",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","li","Internet & Jaringan",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Internet & Jaringan"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Wajib untuk masuk akun, pertandingan daring, unduhan aset, dan sinkronisasi progres. Game offline pun bisa membutuhkannya saat pertama masuk."}]]}],["$","li","Penyimpanan / Foto & Media",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Penyimpanan / Foto & Media"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk menyimpan aset game, tangkapan layar, dan rekaman. Batasi hanya pada file yang kamu pilih bila Android menawarkan pilihan itu."}]]}],["$","li","Mikrofon",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Mikrofon"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Hanya wajar bila kamu memakai obrolan suara. Matikan saat tidak bermain dalam regu atau tidak ingin suaramu terdengar pemain lain."}]]}],["$","li","Notifikasi",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Notifikasi"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk kabar event, pesan regu, dan pembaruan. Atur agar notifikasi promosi tidak mengganggu waktu belajar atau bekerja."}]]}],["$","li","Getar & Layanan Latar",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Getar & Layanan Latar"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk respons kontrol dan menjaga unduhan aset selesai. Periksa pemakaian baterai bila HP terasa cepat panas setelah bermain."}]]}]]}],["$","p",null,{"className":"text-sm text-ink/70","children":["Daftar izin persis dapat berbeda antar versi dan perangkat. Selalu periksa di halaman Play Store aplikasi dan di Pengaturan > Aplikasi > ","Genshin Impact"," > Izin. Baca juga ",["$","$L5",null,{"className":"font-semibold text-linkblue","href":"/panduan/cara-cek-izin-aplikasi","children":"panduan cara cek izin aplikasi"}],"."]}]]}]
2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Genshin Impact"," Aman?"]}],[["$","p","Unduh Genshin Impact han",{"className":"leading-relaxed text-ink/85","children":"Unduh Genshin Impact hanya dari Google Play Store dan pastikan developer-nya adalah COGNOSPHERE PTE. LTD.. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; jangan menerima berkas mod, cheat, atau diamond murah dari chat dan situs pengumpul APK, karena berkas semacam itu adalah cara paling umum akun game dicuri dan perangkat disusupi."}],["$","p","Untuk anak dan remaja, a",{"className":"leading-relaxed text-ink/85","children":"Untuk anak dan remaja, aktifkan persetujuan pembelian di Play Store dan bahas batas waktu bermain sejak awal. Akun game adalah aset digital: gunakan kata sandi unik, verifikasi dua langkah bila tersedia, dan jangan membeli mata uang game dari penjual tidak resmi yang meminta akses akun."}]]]}]
