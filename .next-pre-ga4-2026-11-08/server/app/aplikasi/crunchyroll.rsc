2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Crunchyroll"," Aman?"]}],[["$","p","Unduh Crunchyroll hanya ",{"className":"leading-relaxed text-ink/85","children":"Unduh Crunchyroll hanya dari Google Play Store dan pastikan developer-nya adalah Crunchyroll, LLC. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; jangan memasang aplikasi \"nonton gratis premium\" dari chat dan situs pengumpul APK, karena aplikasi tiruan streaming adalah cara paling umum akun langganan dan data pembayaran dicuri."}],["$","p","Gunakan profil anak dan ",{"className":"leading-relaxed text-ink/85","children":"Gunakan profil anak dan batas usia bila layanan menyediakannya, terutama untuk katalog campuran. Langganan resmi juga melindungi riwayat dan pembayaranmu; akun bersama dari penjual murah sering dicabut dan dapat berasal dari pembayaran curian."}]]]}]
