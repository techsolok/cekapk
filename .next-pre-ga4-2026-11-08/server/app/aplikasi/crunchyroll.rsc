30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Crunchyroll"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Crunchyroll aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Crunchyroll aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah Crunchyroll, LLC. Keamanan akun tontonan setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, jangan membagikan akun langganan kepada penjual murah, dan periksa perangkat yang masuk ke akunmu secara berkala."}]]}],["$","details","Apakah Crunchyroll gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Crunchyroll gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Sebagian konten dapat gratis dengan iklan; akses penuh dan banyak episode terbaru memerlukan langganan Premium berbayar. Periksa rincian paket di Play Store dan di dalam aplikasi sebelum berlangganan, karena harga dan katalog dapat berubah. Jangan membeli akun langganan murah dari penjual pihak ketiga; akun bersama seperti itu sering dicabut dan bisa berasal dari pembayaran curian."}]]}],["$","details","Apakah semua anime di Crunchyroll pasti tersedia di Indonesia?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah semua anime di Crunchyroll pasti tersedia di Indonesia?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tidak. Crunchyroll memegang lisensi per wilayah, sehingga katalog Indonesia bisa berbeda dari Amerika, Eropa, atau Jepang. Sebelum berlangganan demi satu judul, cari judul itu di aplikasi dari akun Indonesia dan periksa musim, episode, serta subtitle-nya. Bila tidak tersedia, kemungkinan lisensinya dipegang layanan lain untuk Indonesia atau belum ada pemegang lisensinya di sini."}]]}],["$","details","Bagaimana cara memasang Crunchyroll yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Crunchyroll yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Crunchyroll langsung di Play Store, cocokkan nama developer Crunchyroll, LLC, lalu ketuk Instal. Setelah selesai, buat profil, atur batas usia bila ada anak yang menonton, dan periksa kualitas video serta izin unduhan sebelum memutar episode pertama."}]]}],["$","details","Kenapa Crunchyroll tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Crunchyroll tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Katalog dan judul tertentu juga dibatasi lisensi per wilayah, jadi tontonan yang ada di satu negara belum tentu ada di negara lain. Bila Play Store menyatakan perangkat tidak kompatibel, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L32"]}]]}]
