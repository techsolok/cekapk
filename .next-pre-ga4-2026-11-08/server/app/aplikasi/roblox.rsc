26:["$","nav",null,{"aria-label":"Isi halaman","className":"flex flex-wrap gap-2 text-sm","children":[["$","a","Ringkasan",{"href":"#ringkasan","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"Ringkasan"}],["$","a","Fitur",{"href":"#fitur","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"Fitur"}],["$","a","Izin",{"href":"#izin","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"Izin"}],["$","a","Keamanan",{"href":"#keamanan","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"Keamanan"}],["$","a","Alternatif",{"href":"#alternatif","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"Alternatif"}],["$","a","FAQ",{"href":"#faq","className":"rounded-full border border-mist px-3 py-1.5 font-medium text-ink/75","children":"FAQ"}]]}]
27:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Roblox bukan satu game, ",{"className":"leading-relaxed text-ink/85","children":"Roblox bukan satu game, melainkan platform berisi jutaan pengalaman (experiences) yang dibuat oleh komunitas kreatornya sendiri dengan Roblox Studio. Di dalamnya ada permainan obby (lompat rintangan), roleplay kota dan sekolah, simulator, tycoon, balapan, sampai permainan horor ringan - semuanya berbagi satu akun, satu avatar, dan satu mata uang virtual bernama Robux. Karena isi platform ini dibuat pengguna, kualitas dan kesesuaian usia tiap pengalaman sangat bervariasi, dan inilah fakta terpenting yang harus dipahami sebelum memasangnya, terutama untuk anak."}],["$","p","Roblox dipakai anak dan ",{"className":"leading-relaxed text-ink/85","children":"Roblox dipakai anak dan remaja Indonesia untuk bermain bersama teman sekolah secara daring lintas perangkat - teman di HP bisa satu ruangan dengan teman di PC atau konsol. Sisi sosialnya kuat: daftar teman, obrolan, grup, dan avatar yang dipersonalisasi membuat Roblox terasa seperti tempat nongkrong digital. Orang tua perlu memperlakukannya sebagai platform sosial yang diawasi, bukan sebagai game anak luring yang aman ditinggal begitu saja setelah dipasang."}]],[["$","div","Cara Roblox Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara Roblox Dipakai Sehari-hari"}],[["$","p","Setelah membuat akun dan",{"className":"leading-relaxed text-ink/85","children":"Setelah membuat akun dan mengatur avatar, kamu memilih pengalaman dari katalog berdasarkan kategori, jumlah pemain, atau rekomendasi teman, lalu masuk dan bermain dengan kontrol layar sentuh sederhana. Robux dipakai untuk membeli pakaian dan aksesori avatar, item di dalam pengalaman, serta game pass yang membuka fitur tertentu dari kreatornya. Kreator yang ingin membuat permainan sendiri memakai Roblox Studio di komputer, bukan dari aplikasi Android, lalu mempublikasikannya agar bisa dimainkan semua orang."}],["$","p","Di game seperti Roblox, ",{"className":"leading-relaxed text-ink/85","children":"Di game seperti Roblox, yang paling terasa bedanya adalah perangkat dan koneksi: frame rate, ping, dan suhu HP menentukan nyaman tidaknya satu pertandingan. Mulailah dari mode santai dan pengaturan grafis menengah, periksa pembelian dalam aplikasi serta izin mikrofon sebelum bermain regu, lalu naikkan pengaturan dan aktifkan fitur lanjutan bila perangkatmu sanggup. Cara bertahap ini membuatmu tahu mana yang benar-benar menambah seru permainan, tanpa mengeluarkan uang atau data untuk fitur yang tidak kamu pakai."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan Roblox",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan Roblox"}],[["$","p","Risiko terbesar Roblox b",{"className":"leading-relaxed text-ink/85","children":"Risiko terbesar Roblox bukan pada gamenya, melainkan pada interaksi dan penipuan di sekitarnya. Obrolan dengan orang asing harus dibatasi lewat pengaturan: aktifkan Account Restrictions untuk anak, tetapkan PIN akun agar pengaturan tidak diubah anak, dan gunakan tanggal lahir yang benar supaya filter konten bekerja. Waspadai situs dan video yang menjanjikan Robux gratis atau penukaran item (trading) di luar platform - pola ini adalah penipuan klasik untuk mencuri akun anak, dan Roblox tidak pernah membagikan Robux lewat situs pihak ketiga."}],"$L32"]]}]]]}]
28:["$","section",null,{"id":"fitur","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Fitur Utama ","Roblox"]}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","li","Katalog Pengalaman Komunitas",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Katalog Pengalaman Komunitas"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Jutaan permainan buatan kreator dalam satu platform, dari obby dan roleplay sampai simulator dan tycoon, terus bertambah setiap hari."}]]}],["$","li","Avatar & Katalog Item",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Avatar & Katalog Item"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Personalisasi avatar dengan pakaian, aksesori, dan animasi dari katalog; sebagian item gratis, sebagian dibeli dengan Robux."}]]}],["$","li","Teman, Obrolan & Grup",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Teman, Obrolan & Grup"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Bermain bersama teman lintas perangkat dengan daftar teman, pesan, dan grup - fitur sosial yang pengaturannya bisa dibatasi orang tua."}]]}],["$","li","Pembatasan Akun & PIN Orang Tua",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Pembatasan Akun & PIN Orang Tua"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Account Restrictions membatasi pengalaman dan komunikasi untuk akun anak, dan PIN akun mengunci pengaturan agar tidak diubah sembarangan."}]]}],["$","li","Robux & Game Pass",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Robux & Game Pass"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Mata uang virtual untuk item avatar dan fitur buatan kreator di dalam pengalaman; dibeli resmi hanya lewat aplikasi atau situs Roblox."}]]}],["$","li","Roblox Studio untuk Kreator",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Roblox Studio untuk Kreator"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Alat pembuat permainan di PC tempat kreator membangun pengalaman dan mempublikasikannya ke seluruh pemain di platform."}]]}]]}]]}]
