2e:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Catatan Versi & Changelog"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Roblox diperbarui langsung oleh developer-nya lewat Play Store; nomor versi dan ukuran persis berbeda antar perangkat dan berubah setiap rilis. Karena itu kami tidak mencetak nomor versi karangan di halaman ini - versi yang kamu terima selalu versi resmi terbaru pada saat kamu menginstal dari sumber resmi. ","Halaman ini terakhir dicek editor pada ","2026-10-20"," dan masuk antrean cek ulang otomatis begitu usianya melewati 90 hari."]}]]}]
2f:["$","section",null,{"id":"alternatif","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Alternatif Legal untuk ","Roblox"]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Minecraft",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/minecraft","className":"font-semibold text-linkblue","children":"Minecraft"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Berbayar sekali beli, dunia balok yang bisa dimainkan luring dan jauh lebih terkendali untuk anak, tanpa katalog konten orang asing."}]]}],["$","li","Genshin Impact",{"className":"rounded-2xl border border-mist p-3","children":[["$","$L5",null,{"href":"/aplikasi/genshin-impact","className":"font-semibold text-linkblue","children":"Genshin Impact"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dunia terbuka buatan developer resmi dengan cerita terstruktur - bukan buatan komunitas - tetapi mengandung gacha sehingga tetap perlu batas belanja."}]]}],["$","li","Stumble Guys",{"className":"rounded-2xl border border-mist p-3","children":[["$","span",null,{"className":"font-semibold text-ink","children":"Stumble Guys"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Game pesta balapan rintangan yang lebih sederhana dan ringan; belum ada di katalog kami, unduh resmi dari Play Store."}]]}]]}]]}]
30:["$","section",null,{"id":"faq","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Pertanyaan Umum tentang ","Roblox"]}],["$","div",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","details","Apakah Roblox aman dipasang?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Roblox aman dipasang?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Aman dipasang bila kamu mengambilnya dari Play Store dan developer-nya adalah Roblox Corporation. Keamanan akun game setelah pemasangan tetap tergantung padamu: gunakan kata sandi unik, aktifkan verifikasi dua langkah bila tersedia, dan jangan pernah membeli mata uang atau item game dari penjual di luar aplikasi resmi."}]]}],["$","details","Apakah Roblox gratis?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Roblox gratis?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Gratis (ada pembelian dalam aplikasi - Robux). Periksa rincian di Play Store sebelum membeli mata uang atau item dalam game, karena harga dan event dapat berubah. Jangan membeli diamond, Robux, atau skin murah dari penjual pihak ketiga; mata uang dari jalur tidak resmi bisa ditarik dan akunmu bisa dibatasi."}]]}],["$","details","Apakah Roblox aman untuk anak saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Apakah Roblox aman untuk anak saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Roblox bisa menjadi relatif aman bila diatur dengan benar: gunakan tanggal lahir asli anak, aktifkan Account Restrictions dan PIN akun, batasi obrolan hanya untuk teman yang dikenal, dan aktifkan persetujuan pembelian di Play Store. Tanpa pengaturan itu, anak dapat masuk ke pengalaman yang tidak sesuai usia dan berbicara dengan orang asing. Tidak ada pengaturan yang menggantikan pendampingan - periksa berkala pengalaman yang dimainkan anak dan ajak ia bercerita tentang teman bermainnya."}]]}],["$","details","Bagaimana cara memasang Roblox yang benar?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Bagaimana cara memasang Roblox yang benar?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Tekan tombol resmi di halaman ini atau cari Roblox langsung di Play Store, cocokkan nama developer Roblox Corporation, lalu ketuk Instal. Setelah selesai, aktifkan persetujuan pembelian di Play Store dan atur izin mikrofon serta notifikasi sebelum bermain, terutama bila HP dipakai anak."}]]}],["$","details","Kenapa Roblox tidak tersedia atau tidak bekerja di HP saya?",{"className":"group p-4","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-ink","children":"Kenapa Roblox tidak tersedia atau tidak bekerja di HP saya?"}],["$","p",null,{"className":"mt-2 leading-relaxed text-ink/75","children":"Ketersediaan dapat dipengaruhi versi Android, wilayah, kebijakan developer, dan kondisi jaringan. Game berat juga menuntut RAM dan penyimpanan yang cukup, jadi perangkat lama mungkin dinyatakan tidak kompatibel. Bila Play Store menyatakan perangkat tidak didukung, jangan memaksa dengan berkas dari situs acak. Perbarui Android dan Play Store bila memungkinkan, atau gunakan alternatif resmi yang tersedia untuk perangkatmu."}]]}],"$L33"]}]]}]
