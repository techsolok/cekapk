2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","Google Maps"," Aman?"]}],[["$","p","Unduh Google Maps hanya ",{"className":"leading-relaxed text-ink/85","children":"Unduh Google Maps hanya dari Google Play Store dan pastikan developer-nya adalah Google LLC. Pencarian Play Store dari tombol di halaman ini mengurangi risiko salah memilih aplikasi peniru dengan nama dan ikon mirip. Setelah terpasang, perbarui hanya dari Play Store; jangan menerima berkas instalasi dari pengemudi, agen perjalanan, atau tautan chat, karena aplikasi layanan tiruan dibuat untuk mencuri alamat, jadwal perjalanan, dan data pembayaranmu."}],["$","p","Layanan utilitas sering ",{"className":"leading-relaxed text-ink/85","children":"Layanan utilitas sering menyimpan alamat, jadwal, dan dokumen penting. Gunakan kata sandi unik, periksa sesi perangkat yang masuk, dan jangan membagikan tangkapan layar berisi kode pemesanan, alamat lengkap, atau QR tiket kepada publik."}]]]}]
