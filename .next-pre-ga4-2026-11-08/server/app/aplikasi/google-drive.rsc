27:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","Google Drive adalah laya",{"className":"leading-relaxed text-ink/85","children":"Google Drive adalah layanan penyimpanan cloud dari Google untuk menyimpan file, foto, video, dokumen, dan cadangan yang dapat dibuka dari HP maupun komputer dengan akun yang sama. Kekuatan utamanya bukan sekadar menyimpan, tetapi menghubungkan file dengan layanan Google lain seperti Docs, Sheets, Slides, dan Gmail. Karena file dapat dibagikan lewat tautan, pengguna harus memahami pengaturan berbagi; kesalahan memilih siapa yang dapat mengakses tautan dapat membuka dokumen pribadi ke orang yang tidak dimaksudkan."}],["$","p","Drive cocok untuk pelaja",{"className":"leading-relaxed text-ink/85","children":"Drive cocok untuk pelajar, pekerja, dan keluarga yang perlu cadangan file penting dan akses lintas perangkat. Gunakan folder dengan nama jelas untuk dokumen identitas, tugas, pekerjaan, dan arsip foto agar pencarian tidak bergantung pada ingatan. Untuk file sensitif, jangan hanya mengandalkan tautan berbagi; periksa daftar orang yang memiliki akses secara berkala dan cabut akses lama saat pekerjaan, kelompok, atau perangkat berubah."}]],[["$","div","Cara Google Drive Dipakai Sehari-hari",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Cara Google Drive Dipakai Sehari-hari"}],[["$","p","Alur kerja yang rapi dim",{"className":"leading-relaxed text-ink/85","children":"Alur kerja yang rapi dimulai dari mengunggah file ke folder yang tepat, mengganti nama file agar mudah dicari, lalu memeriksa pengaturan berbagi sebelum mengirim tautan. Saat bekerja bersama, gunakan komentar dan riwayat versi di aplikasi dokumen Google bila tersedia agar perubahan tidak menimpa pekerjaan orang lain tanpa jejak. Untuk file besar, unggah saat Wi-Fi stabil dan pastikan sinkronisasi selesai sebelum menganggap file sudah aman tersimpan di cloud."}],["$","p","Di aplikasi kerja sepert",{"className":"leading-relaxed text-ink/85","children":"Di aplikasi kerja seperti Google Drive, manfaatnya paling terasa setelah akun, sinkronisasi, dan berbagi diatur dengan benar. Mulailah dari satu dokumen atau rapat, periksa siapa yang bisa melihat dan mengedit, serta ruang penyimpanan yang tersedia, lalu aktifkan integrasi kalender dan template setelah alur dasarmu berjalan. Cara bertahap ini membuatmu tahu fitur mana yang benar-benar mempercepat pekerjaan, tanpa menyerahkan dokumen kepada orang yang salah."}]]]}],["$","div","Yang Perlu Dicek Sebelum Mengandalkan Google Drive",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Yang Perlu Dicek Sebelum Mengandalkan Google Drive"}],[["$","p","Kesalahan paling berisik",{"className":"leading-relaxed text-ink/85","children":"Kesalahan paling berisiko adalah mengatur file menjadi dapat diakses siapa saja yang memiliki tautan padahal isinya KTP, kontrak, data pelanggan, atau dokumen keuangan. Risiko lain adalah phishing yang meniru notifikasi berbagi Drive untuk mencuri akun Google. Jangan masuk akun Google dari tautan email atau chat yang mencurigakan; buka Drive dari aplikasi resmi atau ketik alamatnya sendiri. Akun Google adalah kunci ke email dan banyak layanan lain, jadi perlakukan kata sandi dan pemulihannya dengan sangat serius."}],["$","p","Sebelum membagikan file ",{"className":"leading-relaxed text-ink/85","children":"Sebelum membagikan file penting, buka panel berbagi dan pastikan penerima, tingkat akses melihat atau mengedit, serta masa berlaku bila tersedia sudah benar. Aktifkan verifikasi dua langkah untuk akun Google, periksa perangkat yang masih masuk ke akunmu, dan tinjau file yang dibagikan kepadamu dari pengirim asing. Bila ruang hampir penuh, hapus video besar, duplikat, dan file sampah terlebih dahulu sebelum memutuskan membeli ruang tambahan."}]]]}]]]}]
28:["$","section",null,{"id":"fitur","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Fitur Utama ","Google Drive"]}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","li","Penyimpanan Cloud Lintas Perangkat",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Penyimpanan Cloud Lintas Perangkat"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"File dapat dibuka dari Android, browser, dan komputer selama kamu masuk dengan akun Google yang sama."}]]}],["$","li","Berbagi File dan Folder",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Berbagi File dan Folder"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Tautan dan undangan email memudahkan kerja bersama, dengan tingkat akses yang harus dipilih hati-hati."}]]}],["$","li","Integrasi Dokumen Google",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Integrasi Dokumen Google"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Terhubung dengan Docs, Sheets, dan Slides untuk membuat serta mengedit dokumen di cloud."}]]}],["$","li","Pencarian File",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Pencarian File"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Nama file, jenis dokumen, dan isi tertentu dapat dicari agar arsip lama lebih mudah ditemukan."}]]}],["$","li","Cadangan dan Sinkronisasi",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Cadangan dan Sinkronisasi"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Membantu menyimpan salinan file penting di luar memori HP yang bisa rusak atau hilang."}]]}],["$","li","Kontrol Akses dan Aktivitas",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kontrol Akses dan Aktivitas"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Pemilik file dapat meninjau siapa yang memiliki akses dan mengubah izin berbagi bila diperlukan."}]]}]]}]]}]
