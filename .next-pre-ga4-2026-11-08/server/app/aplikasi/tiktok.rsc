2a:["$","section",null,{"id":"izin","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Izin Aplikasi & Artinya"}],["$","p",null,{"className":"leading-relaxed text-ink/85","children":["Izin adalah \"kunci\" yang kamu berikan ke aplikasi. Ini izin yang umumnya diminta ","TikTok"," dan arti sederhananya:"]}],null,["$","ul",null,{"className":"divide-y divide-mist rounded-2xl border border-mist","children":[["$","li","Kamera",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kamera"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dipakai untuk merekam video langsung di dalam aplikasi. Wajar untuk aplikasi video; bisa dimatikan bila kamu hanya menonton, tetapi kamu tidak bisa merekam saat izin ini mati."}]]}],["$","li","Mikrofon",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Mikrofon"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk merekam suara saat membuat video dan saat siaran langsung. Tidak dibutuhkan bila kamu hanya menonton."}]]}],["$","li","Penyimpanan / Foto & Video",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Penyimpanan / Foto & Video"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Untuk mengunggah video dari galeri dan menyimpan hasil unduhan atau draf. Di Android baru, izin ini terbatas pada file yang kamu pilih."}]]}],["$","li","Kontak",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kontak"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Opsional - dipakai bila kamu ingin menemukan teman dari kontak HP. Kamu bisa menolak izin ini dan TikTok tetap berfungsi normal."}]]}],["$","li","Notifikasi",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Notifikasi"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Memberi tahu ada komentar, suka, pesan, atau live dari akun yang kamu ikuti. Atur seperlunya agar tidak mengganggu."}]]}],["$","li","Lokasi (perkiraan)",{"className":"p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Lokasi (perkiraan)"}],["$","p",null,{"className":"mt-0.5 text-sm leading-relaxed text-ink/75","children":"Dipakai untuk konten dan iklan yang relevan dengan wilayahmu. Izin lokasi presisi tidak wajib untuk memakai TikTok."}]]}]]}],["$","p",null,{"className":"text-sm text-ink/70","children":["Daftar izin persis dapat berbeda antar versi dan perangkat. Selalu periksa di halaman Play Store aplikasi dan di Pengaturan > Aplikasi > ","TikTok"," > Izin. Baca juga ",["$","$L5",null,{"className":"font-semibold text-linkblue","href":"/panduan/cara-cek-izin-aplikasi","children":"panduan cara cek izin aplikasi"}],"."]}]]}]
2b:["$","section",null,{"id":"keamanan","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Apakah ","TikTok"," Aman?"]}],[["$","p","TikTok resmi dari Play S",{"className":"leading-relaxed text-ink/85","children":"TikTok resmi dari Play Store adalah aplikasi yang aman dari sisi perangkat lunak: ia lolos pemindaian Google Play Protect dan diperbarui langsung oleh TikTok Pte. Ltd. Risiko terbesar justru datang dari versi tidak resmi - misalnya file bertajuk TikTok mod, TikTok tanpa iklan, atau TikTok premium dari situs acak. File seperti itu tidak ada di Play Store, sering disusupi iklan agresif atau pencuri data, dan akunmu bisa diblokir karena melanggar ketentuan layanan."}],["$","p","Dari sisi privasi, sadar",{"className":"leading-relaxed text-ink/85","children":"Dari sisi privasi, sadari bahwa TikTok mengumpulkan data penggunaan untuk rekomendasi dan iklan - ini tertulis di kebijakan privasinya. Kurangi jejak dengan mengaktifkan akun privat bila perlu, membatasi siapa yang bisa mengirim pesan, dan meninjau izin aplikasi secara berkala. Untuk anak, gunakan Family Pairing dan mode terbatas, dan sepakati batas waktu layar."}]]]}]
