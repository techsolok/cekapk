27:["$","section",null,{"id":"ringkasan","className":"space-y-4","children":[[["$","p","TikTok adalah aplikasi b",{"className":"leading-relaxed text-ink/85","children":"TikTok adalah aplikasi berbagi video pendek yang memungkinkan siapa pun merekam, mengedit, dan menonton video vertikal berdurasi singkat sampai beberapa menit. Di Indonesia, TikTok dipakai untuk hiburan, belajar singkat, berita ringan, sampai jualan online lewat TikTok Shop dan live streaming."}],["$","p","Halaman ini adalah halam",{"className":"leading-relaxed text-ink/85","children":"Halaman ini adalah halaman info resmi versi kami: fakta aplikasi, izin yang diminta dan artinya, penilaian keamanan yang jujur, serta tombol ke Google Play Store. Kami tidak menyediakan file APK TikTok, karena cara teraman mendapatkan TikTok selalu dari Play Store atau App Store resmi."}]],[["$","div","Apa Itu TikTok dan Bagaimana Cara Kerjanya?",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Apa Itu TikTok dan Bagaimana Cara Kerjanya?"}],[["$","p","Begitu dibuka, TikTok me",{"className":"leading-relaxed text-ink/85","children":"Begitu dibuka, TikTok menampilkan tab For You (FYP) yang isinya dipilih algoritma berdasarkan video yang kamu tonton, sukai, dan lewati. Semakin sering kamu menonton satu topik, semakin sering topik itu muncul. Di samping FYP ada tab Following untuk akun yang kamu ikuti, fitur pencarian, pesan masuk, dan profil."}],["$","p","Untuk kreator, TikTok me",{"className":"leading-relaxed text-ink/85","children":"Untuk kreator, TikTok menyediakan kamera bawaan dengan filter, efek, stiker, dan perpustakaan musik berlisensi di dalam aplikasi. Video bisa direkam langsung atau diunggah dari galeri, lalu ditambah teks, suara, dan efek transisi. Banyak kreator Indonesia mengedit video lebih dulu di CapCut - aplikasi editor dari ekosistem yang sama - lalu mengunggahnya ke TikTok."}]]]}],["$","div","TikTok Shop dan Live Streaming di Indonesia",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"TikTok Shop dan Live Streaming di Indonesia"}],[["$","p","Di Indonesia, TikTok ter",{"className":"leading-relaxed text-ink/85","children":"Di Indonesia, TikTok terhubung dengan ekosistem e-commerce Tokopedia untuk fitur belanja. Kreator dan penjual bisa menautkan produk ke video dan siaran langsung, dan penonton bisa membeli tanpa keluar aplikasi. Fitur ini membuat TikTok bukan hanya aplikasi hiburan, tetapi juga kanal jualan utama bagi banyak UMKM."}],["$","p","Live streaming memungkin",{"className":"leading-relaxed text-ink/85","children":"Live streaming memungkinkan kreator berinteraksi langsung dengan penonton lewat komentar dan hadiah virtual. Untuk anak di bawah umur, TikTok membatasi beberapa fitur termasuk live dan pesan langsung. Orang tua sebaiknya mendampingi penggunaan anak dan memanfaatkan fitur Family Pairing serta pembatasan waktu layar yang tersedia di pengaturan."}]]]}],["$","div","Berapa Ukuran TikTok dan HP Apa yang Cukup?",{"className":"space-y-3 pt-2","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Berapa Ukuran TikTok dan HP Apa yang Cukup?"}],[["$","p","Ukuran unduhan TikTok di",{"className":"leading-relaxed text-ink/85","children":"Ukuran unduhan TikTok di Play Store bervariasi menurut perangkat, dan ukuran terpasang akan tumbuh karena cache video. Di HP dengan penyimpanan 32 GB, cache TikTok yang menumpuk adalah penyebab umum memori penuh; bersihkan lewat Pengaturan di dalam aplikasi secara berkala. TikTok juga menyediakan versi Lite di sebagian wilayah, tetapi untuk Indonesia cara paling aman tetap aplikasi utama dari Play Store."}],"$L33"]]}]]]}]
28:["$","section",null,{"id":"fitur","className":"space-y-3","children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":["Fitur Utama ","TikTok"]}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","li","FYP (For You Page)",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"FYP (For You Page)"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Umpan video yang dipersonalisasi algoritma berdasarkan minat dan kebiasaan menontonmu, menjadi ciri khas utama TikTok."}]]}],["$","li","Kamera & Efek Video",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kamera & Efek Video"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Rekam langsung dengan filter wajah, efek AR, stiker, timer, dan perpustakaan musik serta suara yang luas."}]]}],["$","li","Live Streaming",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Live Streaming"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Siaran langsung dengan komentar real-time, hadiah virtual, dan fitur belanja untuk kreator serta penjual yang memenuhi syarat."}]]}],["$","li","Duet & Stitch",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Duet & Stitch"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Membuat video berdampingan dengan video kreator lain (Duet) atau menyambung cuplikan video orang lain (Stitch) bila pemiliknya mengizinkan."}]]}],["$","li","Pesan & Komentar",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Pesan & Komentar"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Pesan langsung, komentar video, dan fitur berbagi ke aplikasi lain untuk berinteraksi dengan teman dan kreator."}]]}],["$","li","Kontrol Waktu & Keluarga",{"className":"rounded-2xl border border-mist p-3","children":[["$","p",null,{"className":"font-semibold text-ink","children":"Kontrol Waktu & Keluarga"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-ink/75","children":"Pengingat waktu layar, mode terbatas, dan Family Pairing agar orang tua bisa mendampingi akun anak remajanya."}]]}]]}]]}]
